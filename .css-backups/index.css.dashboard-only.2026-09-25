@import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap");
@import "tailwindcss";

@theme inline {
  --font-sans: "Outfit", sans-serif;
  --font-mono: "JetBrains Mono", monospace;
}

:root {
  /* System font stack with Outfit as primary, optimized for each browser */
  font-family: "Outfit", 
    -apple-system, BlinkMacSystemFont, /* macOS/iOS */
    "Segoe UI", /* Windows */
    "Roboto", "Oxygen", "Ubuntu", "Cantarell", /* Linux */
    "Helvetica Neue", sans-serif; /* Universal fallback */
  
  font-synthesis: none;
  
  /* Browser-optimized font rendering */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  
  /* Dynamic base font size: scales between 14px (small screens) and 16px (large screens) */
  /* User can still zoom and browser will respect their preferences */
  font-size: clamp(14px, 0.875rem + 0.25vw, 16px);
}

/* ========================================
   THEME SYSTEM - Light & Dark Modes
   ======================================== */

/* Light Theme (Default) */
:root, .light {
  /* Base Colors */
  --color-bg: #ffffff;
  --color-bg-secondary: #f8f9fa;
  --color-bg-tertiary: #f0f0f0;
  
  /* Surface Colors (Cards, Panels) */
  --color-surface: #ffffff;
  --color-surface-elevated: #ffffff;
  --color-surface-hover: #f8f9fa;
  
  /* Text Colors */
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #6b7280;
  --color-text-tertiary: #9ca3af;
  --color-text-inverse: #ffffff;
  
  /* Border Colors */
  --color-border: #e5e7eb;
  --color-border-hover: #d1d5db;
  --color-border-focus: #9ca3af;
  
  /* Brand/Accent Colors */
  --color-accent: #e3ff4d;
  --color-accent-hover: #d4f03d;
  --color-accent-text: #171719;
  
  /* Status Colors */
  --color-success: #10b981;
  --color-success-bg: #d1fae5;
  --color-success-text: #065f46;
  
  --color-warning: #f59e0b;
  --color-warning-bg: #fef3c7;
  --color-warning-text: #92400e;
  
  --color-error: #ef4444;
  --color-error-bg: #fee2e2;
  --color-error-text: #991b1b;
  
  --color-info: #3b82f6;
  --color-info-bg: #dbeafe;
  --color-info-text: #1e40af;
  
  /* Shadow */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  
  /* Dashboard-specific variables */
  --canvas: #f8f9fa;
  --chrome: #ffffff;
  --surface: #ffffff;
  --surface-2: #f8f9fa;
  --surface-3: #f0f0f0;
  --text: #1a1a1a;
  --muted: #6b7280;
  --faint: #9ca3af;
  --line: rgba(0, 0, 0, 0.1);
  --accent: #e3ff4d;
  
  color-scheme: light;
}

/* Dark Theme */
.dark {
  /* Base Colors */
  --color-bg: #0f0f10;
  --color-bg-secondary: #1a1a1b;
  --color-bg-tertiary: #242426;
  
  /* Surface Colors (Cards, Panels) */
  --color-surface: #1a1a1b;
  --color-surface-elevated: #242426;
  --color-surface-hover: #2d2d30;
  
  /* Text Colors */
  --color-text-primary: #f6f6f3;
  --color-text-secondary: #94969e;
  --color-text-tertiary: #65666e;
  --color-text-inverse: #1a1a1a;
  
  /* Border Colors */
  --color-border: rgba(255, 255, 255, 0.1);
  --color-border-hover: rgba(255, 255, 255, 0.15);
  --color-border-focus: rgba(255, 255, 255, 0.25);
  
  /* Brand/Accent Colors */
  --color-accent: #e3ff4d;
  --color-accent-hover: #f0ff6d;
  --color-accent-text: #171719;
  
  /* Status Colors */
  --color-success: #10b981;
  --color-success-bg: #064e3b;
  --color-success-text: #6ee7b7;
  
  --color-warning: #f59e0b;
  --color-warning-bg: #78350f;
  --color-warning-text: #fcd34d;
  
  --color-error: #ef4444;
  --color-error-bg: #7f1d1d;
  --color-error-text: #fca5a5;
  
  --color-info: #3b82f6;
  --color-info-bg: #1e3a8a;
  --color-info-text: #93c5fd;
  
  /* Shadow */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5);
  
  /* Dashboard-specific variables */
  --canvas: #0f0f10;
  --chrome: #101012;
  --surface: #1a1a1b;
  --surface-2: #242426;
  --surface-3: #2d2d30;
  --text: #f6f6f3;
  --muted: #94969e;
  --faint: #65666e;
  --line: rgba(255, 255, 255, 0.1);
  --accent: #e3ff4d;
  
  color-scheme: dark;
}

/* Apply theme colors to body */
body {
  background-color: var(--color-bg);
  color: var(--color-text-primary);
}

/* Smooth theme transitions */
* {
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}

/* Respect user's system font size preferences */
@media (prefers-reduced-motion: no-preference) {
  :root {
    scroll-behavior: smooth;
  }
}

/* Larger base font for better readability on high-DPI displays */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
  :root {
    font-size: clamp(15px, 0.9375rem + 0.25vw, 17px);
  }
}

/* Firefox-specific optimizations */
@supports (-moz-appearance: none) {
  :root {
    /* Firefox renders fonts slightly bolder, so we compensate */
    font-weight: 400;
  }
}

/* Safari-specific optimizations */
@supports (-webkit-hyphens: none) {
  :root {
    /* Safari benefits from slightly looser letter spacing */
    letter-spacing: 0.01em;
  }
}

/* Windows-specific: Better rendering with ClearType */
@media (prefers-color-scheme: light) {
  @supports (-ms-ime-align: auto) {
    :root {
      font-smoothing: auto;
      -webkit-font-smoothing: auto;
    }
  }
}

/* Accessibility: Respect user's font size preferences */
@media (min-width: 1920px) {
  /* Larger screens get slightly larger base font */
  :root {
    font-size: clamp(16px, 1rem + 0.25vw, 18px);
  }
}

/* Tablet/smaller screens: slightly smaller but still readable */
@media (max-width: 1440px) {
  :root {
    font-size: clamp(14px, 0.875rem + 0.2vw, 15px);
  }
  
  .stat-card strong {
    font-size: clamp(28px, 1.75rem + 0.5vw, 32px);
  }
  
  .topbar h1 {
    font-size: clamp(28px, 2vw + 0.5rem, 40px);
  }
}

body { margin: 0; min-width: 1120px; min-height: 100vh; }

/* Enhanced readability: Adjust line height based on viewport */
body {
  line-height: clamp(1.4, 1.3 + 0.2vw, 1.6);
}

button, input, select, textarea { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { 
  outline: 2px solid var(--color-accent); 
  outline-offset: 2px; 
}

/* Scrollbar Styling - Light & Dark */
::-webkit-scrollbar { 
  width: 8px; 
  height: 8px; 
}

::-webkit-scrollbar-track { 
  background: transparent; 
}

::-webkit-scrollbar-thumb { 
  background: var(--color-border-hover); 
  border-radius: 10px; 
}

::-webkit-scrollbar-thumb:hover { 
  background: var(--color-border-focus); 
}

.dark ::-webkit-scrollbar-thumb { 
  background: rgba(255, 255, 255, 0.2); 
}

.dark ::-webkit-scrollbar-thumb:hover { 
  background: rgba(255, 255, 255, 0.3); 
}

.app {
  display: flex; 
  width: 100vw; 
  height: 100vh; 
  overflow: hidden; 
  background: var(--canvas); 
  color: var(--text);
}

.app main { 
  flex: 1; 
  min-width: 0; 
  display: flex; 
  flex-direction: column; 
  overflow: hidden; 
}
.sidebar { width: 226px; margin: 14px 0 14px 14px; border-radius: 24px; background: var(--chrome); display: flex; flex-direction: column; flex: 0 0 auto; transition: width .25s; overflow: hidden; }
.sidebar.collapsed { width: 70px; }
.brand { height: 90px; display: flex; align-items: center; gap: 12px; padding: 0 21px; letter-spacing: .18em; }
.brand b { font-size: clamp(15px, 0.9375rem + 0.125vw, 16px); white-space: nowrap; }
.brand-mark { width: 28px; height: 28px; flex: 0 0 28px; background: var(--accent); border-radius: 9px; display: grid; place-items: center; }
.brand-mark span { width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-bottom: 12px solid #171719; transform: translateY(-1px); }
.sidebar nav { padding: 4px 10px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
.sidebar nav button { border: 0; background: transparent; color: #898a91; min-height: 45px; padding: 0 12px; border-radius: 14px; display: flex; align-items: center; gap: 13px; cursor: pointer; position: relative; text-align: start; white-space: nowrap; }
.sidebar nav button:hover { background: var(--surface-2); color: var(--text); }
.sidebar nav button.active { background: var(--accent); color: #151516; font-weight: 700; }
.nav-icon { width: 20px; display: grid; place-items: center; flex: 0 0 auto; }
.sidebar nav em { margin-inline-start: auto; font-style: normal; font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); min-width: 20px; height: 20px; border-radius: 10px; background: var(--surface-3); color: var(--text); display: grid; place-items: center; }
.sidebar nav .active em { background: #171719; color: #f5f5f2; }
.collapsed nav button { justify-content: center; padding: 0; }
.collapsed nav button:hover:after { content: attr(title); position: fixed; margin-inline-start: 116px; background: var(--accent); color: #171719; padding: 7px 11px; border-radius: 12px; font-size: 14px; font-weight: 700; z-index: 50; }
.sidebar-foot { padding: 10px 12px 16px; position: relative; }
.support { background: var(--surface); border-radius: 15px; padding: 12px; display: flex; flex-direction: column; gap: 5px; margin-bottom: 10px; }
.support span { color: var(--muted); font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); }
.support b { font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); font-weight: 500; }
.support i, .access i { width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: #85a88c; margin-inline-end: 7px; }
.collapse-button { position: absolute; inset-inline-end: -11px; top: -33px; width: 24px; height: 24px; border-radius: 50%; border: 3px solid var(--canvas); background: var(--surface-3); display: grid; place-items: center; cursor: pointer; }
.collapse-button svg { width: 11px; }.collapsed .collapse-button svg { transform: rotate(180deg); }.collapsed .collapse-button { top: -20px; }
[dir="rtl"] .collapse-button svg { transform: rotate(180deg); }[dir="rtl"] .collapsed .collapse-button svg { transform: none; }
.logout { border: 0; background: transparent; color: var(--muted); display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 11px; cursor: pointer; }
.topbar { flex: 0 0 auto; min-height: 104px; padding: 19px 28px 12px 30px; display: flex; align-items: center; justify-content: space-between; }
.topbar h1 { font-size: clamp(32px, 2.5vw + 1rem, 48px); line-height: 1.1; margin: 0 0 7px; letter-spacing: -.04em; }
.topbar p { margin: 0; color: var(--muted); font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); }
.top-actions, .row-actions { display: flex; align-items: center; gap: 8px; }
.toggle { background: var(--surface-2); padding: 3px; border-radius: 13px; display: inline-flex; gap: 2px; }
.toggle button { border: 0; background: transparent; color: var(--muted); border-radius: 10px; padding: 7px 11px; font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); cursor: pointer; }
.toggle button.active { background: var(--text); color: var(--chrome); font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
.notification, .icon-button { width: 37px; height: 37px; border-radius: 50%; border: 0; background: var(--surface); display: grid; place-items: center; cursor: pointer; position: relative; }
.notification i { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); top: 8px; inset-inline-end: 8px; }
.avatar { width: 34px; height: 34px; border-radius: 50%; display: inline-grid; place-items: center; flex: 0 0 auto; color: #eef7ce; font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); font-weight: 700; }
.page-body { flex: 1; overflow: auto; padding: 8px 28px 28px 30px; display: flex; flex-direction: column; gap: 14px; }
.page-actions { min-height: 42px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.chips { display: flex; align-items: center; gap: 6px; }
.chips button { background: rgba(20,20,22,.48); border: 0; color: rgba(255,255,255,.72); padding: 9px 13px; border-radius: 12px; font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); cursor: pointer; white-space: nowrap; }
.chips button.selected { background: var(--surface); color: var(--text); box-shadow: inset 0 0 0 1px var(--line); }
.chips button b { background: var(--accent); color: #171719; padding: 1px 5px; border-radius: 8px; margin-inline-start: 4px; }
.search { height: 38px; min-width: 210px; background: var(--surface); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; color: var(--faint); box-shadow: inset 0 0 0 1px var(--line); }
.search input { border: 0; outline: 0; background: transparent; color: var(--text); width: 100%; font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); }
.primary, .secondary, .danger-button, .contact { border: 0; min-height: 38px; border-radius: 12px; padding: 0 15px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); font-weight: 700; cursor: pointer; }
.primary { background: var(--accent); color: #171719; }.secondary { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--line); }.danger-button { background: #4b292b; color: #e5aaa8; }.contact { background: #263d31; color: #a9cdb5; }
.full { width: 100%; }.stats { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; }
.stat-card, .card, .table-card { background: var(--surface); border-radius: 20px; box-shadow: 0 10px 30px rgba(15,15,17,.06); }
.stat-card { min-height: 120px; padding: 19px 21px; display: flex; flex-direction: column; }
.stat-card > span { color: var(--muted); font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); }
.stat-card strong { font-size: clamp(32px, 2rem + 0.5vw, 36px); line-height: 1; margin: 13px 0 7px; letter-spacing: -.035em; }
.stat-card small { color: var(--faint); font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); }
.stat-card.hero { background: var(--accent); color: #171719; }.stat-card.hero span,.stat-card.hero small { color: #455019; }

.corridor { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; background: var(--surface-2); border-radius: 16px; overflow: hidden; position: relative; }
.corridor > div { padding: 14px 16px; min-width: 0; }.corridor > div:last-child { text-align: end; }.corridor small { display: block; color: var(--faint); font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); margin-bottom: 3px; }
.corridor b { display: block; font-size: clamp(15px, 0.9375rem + 0.125vw, 16px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.corridor > span { align-self: center; z-index: 1; background: var(--surface-3); color: var(--muted); width: 30px; height: 30px; border-radius: 11px; display: grid; place-items: center; margin: 0 -15px; }
.corridor.compact { border-radius: 11px; }.corridor.compact > div { padding: 8px; }.corridor.compact small { display: none; }.corridor.compact b { font-size: 12px; font-weight: 500; }.corridor.compact > span { width: 22px; height: 22px; font-size: 12px; margin: 0 -11px; border-radius: 8px; }
.person { display: flex; align-items: center; gap: 8px; min-width: 0; }

.table-card { overflow: hidden; }.table-head,.table-row { display: grid; align-items: center; gap: 12px; padding: 0 20px; }
.table-head { min-height: 40px; color: var(--faint); font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); background: var(--surface-2); }
.table-row { min-height: 64px; border: 0; border-bottom: 1px solid var(--line); background: transparent; text-align: start; font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); width: 100%; }
.table-row:hover { background: rgba(227,255,77,.025); box-shadow: inset 3px 0 var(--accent); }.table-row:last-child { border-bottom: 0; }.table-row small { color: var(--muted); }.table-row .avatar { width: 30px; height: 30px; }.table-row .person > span { display: flex; flex-direction: column; gap: 2px; }.table-row .person b { font-size: clamp(13px, 0.8125rem + 0.125vw, 14px); }
.mono { color: var(--accent); font: 600 clamp(13px, 0.8125rem + 0.125vw, 14px) "JetBrains Mono",monospace; }
.quote-requests-grid { grid-template-columns: .72fr 1fr 1fr .66fr .78fr .78fr 1.05fr; }.agents-grid { grid-template-columns: 1.4fr 1.1fr .6fr .8fr .8fr .6fr; }.business-grid { grid-template-columns: 1.45fr .8fr .7fr 1fr .65fr .6fr; }.team-grid { grid-template-columns: 1.5fr .7fr .9fr .65fr 1.1fr; }
.status { width: max-content; border-radius: 20px; padding: 5px 8px; display: inline-flex; align-items: center; gap: 6px; font-size: clamp(11px, 0.6875rem + 0.125vw, 12px); white-space: nowrap; background: #2a302d; color: #99b1a2; }
.status i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.status.warning { background:#353129;color:#c1aa7b}.status.info{background:#293039;color:#8faabd}.status.danger{background:#39292b;color:#c9918d}.status.neutral{background:#2d2d31;color:#97979d}
.row-actions { justify-content: flex-end; }.row-actions button { border: 0; background: var(--surface-2); min-width: 29px; height: 29px; padding: 0 8px; border-radius: 9px; display: grid; place-items: center; cursor: pointer; font-size: 12px; }.row-actions svg { width: 14px; }.row-actions .text-button { color: var(--accent); width: auto; }.row-actions .remove { color: #c9918d; }.rating { color: #b7a979; }.access { color: var(--muted); font-size: 12px; }
.page-actions select { height: 38px; background: var(--surface); color: var(--text); border: 0; border-radius: 12px; padding: 0 32px 0 12px; box-shadow: inset 0 0 0 1px var(--line); font-size: 14px; }
.map-layout { flex: 1; min-height: 0; display: grid; grid-template-columns: 320px 1fr; gap: 14px; }.map-list { padding: 16px; overflow: auto; }.card-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13px; }.card-title h3 { margin: 0 0 3px; font-size: 18px; }.card-title p { margin: 0; color: var(--muted); font-size: 12px; }.map-list .search { margin-bottom: 13px; }
.map-job { border: 0; border-top: 1px solid var(--line); background: transparent; padding: 13px 7px; width: 100%; display: flex; flex-direction: column; gap: 10px; text-align: start; cursor: pointer; position: relative; }.map-job.selected:before { content:""; position:absolute; inset-inline-start:-16px; top:10px; bottom:10px; width:3px; background:var(--accent); border-radius:3px; }.map-job > div:first-child { display: flex; justify-content: space-between; }.map-job b { font: 600 14px "JetBrains Mono",monospace; }.map-job .person { font-size: 14px; }.map-job .avatar { width: 24px; height: 24px; font-size: 10px; }.signal { color: #87ab91; font-size: 12px; }.signal:before { content:""; display:inline-block; width:5px; height:5px; border-radius:50%; background:currentColor; margin-inline-end:5px; }.signal.stale { color: #a5977f; }
.map-card { padding: 12px; min-width: 0; display: flex; flex-direction: column; }.map-legend { display: flex; gap: 18px; padding: 5px 6px 13px; justify-content: flex-end; color: var(--muted); font-size: 12px; }.map-legend span { display: flex; align-items: center; gap: 5px; }.map-legend i { width: 6px; height: 6px; border-radius: 50%; background: #7f9d87; }.map-legend i.stale{background:#85868b}.map-legend i.pickup{background:#768fa9}.map-legend i.delivery{background:#a27675}
.map-graphic { flex: 1; min-height: 420px; overflow: hidden; border-radius: 16px; position: relative; background: #202329; }.map-graphic svg { width: 100%; height: 100%; }.map-graphic text { fill:#73777d; font: 12px "Outfit",sans-serif; }.map-expand { position: absolute; top: 14px; inset-inline-end: 14px; width: 35px; height: 35px; border: 0; border-radius: 50%; background: #171719; display: grid; place-items: center; }.fit-button { position: absolute; bottom: 16px; inset-inline-end: 16px; border:0; background:var(--accent); color:#171719; padding:9px 13px; border-radius:11px; font-weight:700; font-size:14px; }
.alerts-layout { display:grid;grid-template-columns:1fr 285px;gap:14px; }.alert-feed { overflow:hidden; }.alert-row { display:grid;grid-template-columns:38px 1fr auto;gap:13px;padding:18px;border-bottom:1px solid var(--line);align-items:start}.alert-row:last-child{border-bottom:0}.severity{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:#39292b;color:#c9918d}.severity-warning{background:#353129;color:#c1aa7b}.severity-info{background:#293039;color:#8faabd}.alert-meta{display:flex;align-items:center;gap:8px}.alert-meta small{color:var(--faint);font-size:12px}.alert-row h3{font-size:16px;margin:8px 0 4px}.alert-row p{font-size:14px;color:var(--muted);margin:0}.deep-link{border:0;background:transparent;color:var(--accent);display:flex;align-items:center;gap:5px;padding:8px 0 0;font:600 12px "JetBrains Mono",monospace}.response-card{padding:22px}.eyebrow{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.11em;font-weight:700}.response-card>strong{display:block;font-size:55px;line-height:1;margin:24px 0 6px}.response-card h3{font-size:18px;margin:0}.response-card p{font-size:14px;color:var(--muted);line-height:1.6}.response-bars{margin-top:28px;display:flex;flex-direction:column;gap:14px}.response-bars span{font-size:12px;color:var(--muted);position:relative;padding-top:8px}.response-bars span:before,.response-bars i{content:"";position:absolute;top:0;inset-inline:0;height:3px;border-radius:3px;background:var(--surface-3)}.response-bars i{inset-inline-end:auto;background:#8f7772}.empty-state{margin:auto;width:min(500px,100%);padding:55px;text-align:center}.empty-state>span{margin:auto;width:55px;height:55px;border-radius:20px;background:#29352d;color:#9bb09f;display:grid;place-items:center}.empty-state h2{margin:18px 0 7px}.empty-state p{color:var(--muted);font-size:14px;line-height:1.6;max-width:340px;margin:auto}
.modal-backdrop { position: fixed; z-index: 100; inset: 0; background: rgba(7,7,8,.74); backdrop-filter: blur(7px); display: flex; align-items: center; justify-content: center; padding: 28px; }
.modal-panel { width: min(1120px,calc(100vw - 56px)); max-height: calc(100vh - 56px); overflow: auto; background: var(--surface); border-radius: 26px; box-shadow: 0 30px 90px rgba(0,0,0,.45); }
.modal-header { position: sticky; top: 0; z-index: 4; background: var(--surface); padding: 22px 26px 16px; display: flex; align-items: start; justify-content: space-between; border-bottom: 1px solid var(--line); }.modal-title { display:flex;align-items:center;gap:12px}.modal-title h2{font-size:30px;margin:5px 0 0;letter-spacing:-.03em}.section-title{display:flex;align-items:end;justify-content:space-between;margin:0 0 12px}.section-title h3{margin:0;font-size:16px}.section-title p{color:var(--muted);font-size:12px;margin:3px 0 0}.section-title button{border:0;background:transparent;color:var(--accent);font-size:12px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}.field{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:12px}.field.wide{grid-column:1/-1}.field input,.field select,.field textarea{background:var(--surface-2);color:var(--text);border:0;border-radius:11px;padding:10px 11px;box-shadow:inset 0 0 0 1px var(--line);font-size:14px;min-width:0}.field textarea{min-height:64px;resize:vertical}.field input:disabled{color:var(--faint)}.muted-field textarea{background:#242522}.timeline{margin-bottom:20px}.form-modal{width:min(760px,calc(100vw - 56px))}.form-section{padding:19px 26px 0;border-bottom:1px solid var(--line)}.form-modal .form-section:last-of-type{border-bottom:0}.modal-footer{display:flex;justify-content:flex-end;gap:8px;padding:17px 26px;border-top:1px solid var(--line);position:sticky;bottom:0;background:var(--surface)}.simple-modal{width:min(520px,calc(100vw - 56px))}.simple-body{padding:22px 26px}.simple-body>.field{margin-bottom:14px}.modal-copy{color:var(--muted);font-size:14px;line-height:1.6;margin:0 0 18px}.profile-hero,.contact-card,.session-row,.permission-note{display:flex;align-items:center;gap:12px;background:var(--surface-2);border-radius:15px;padding:14px;margin-bottom:18px}.profile-hero .avatar{width:44px;height:44px}.profile-hero>div,.contact-card>div{flex:1}.profile-hero b,.contact-card b,.session-row b,.permission-note b{font-size:14px}.profile-hero p,.contact-card p,.session-row p,.permission-note p{color:var(--muted);font-size:12px;margin:3px 0 0}.session-row{justify-content:space-between}.permission-note{display:block;border-inline-start:3px solid var(--accent)}

@media (max-height: 760px) {
  .stat-card { min-height: 102px; }.stat-card strong { font-size: 27px; margin: 9px 0 5px; }
  .topbar { min-height: 88px; }.topbar h1 { font-size: 34px; }.sidebar { margin-top: 10px; margin-bottom: 10px; }
}

/* High-density enterprise views: Team and Agent management */
.app.enterprise-mode {
  --canvas: #f8fafc;
  --chrome: #0f172a;
  --surface: #ffffff;
  --surface-2: #f1f5f9;
  --surface-3: #e2e8f0;
  --text: #0f172a;
  --muted: #475569;
  --faint: #64748b;
  --line: #e2e8f0;
  background: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
}
.enterprise-mode .sidebar { margin: 0; border-radius: 0; }
.enterprise-mode .sidebar nav button { color: #cbd5e1; font-weight: 500; }
.enterprise-mode .sidebar nav button:hover { background: rgba(255,255,255,.07); color: #fff; }
.enterprise-mode .sidebar nav button.active { background: rgba(227,255,77,.1); color: #efffa5; box-shadow: inset 2px 0 #c8e640; }
[dir="rtl"] .enterprise-mode .sidebar nav button.active { box-shadow: inset -2px 0 #c8e640; }
.enterprise-mode .sidebar nav em { height: 18px; min-width: 18px; padding: 0 5px; border-radius: 9px; background: #334155; color: #cbd5e1; font-size: 11px; font-weight: 600; }
.enterprise-mode .sidebar nav .active em { background: rgba(227,255,77,.12); color: #efffa5; }
.enterprise-mode .support { border: 1px solid rgba(255,255,255,.08); border-radius: 6px; background: rgba(255,255,255,.04); }
.enterprise-mode .support > span { color: #e2e8f0; font-size: 14px; font-weight: 700; letter-spacing: .01em; }
.enterprise-mode .support b { color: #cbd5e1; font-size: 12px; font-weight: 500; }
.enterprise-mode .logout { color: #cbd5e1; font-size: 14px; font-weight: 500; }
.enterprise-mode .collapse-button { width: 28px; height: 28px; inset-inline-end: -14px; border-color: #f8fafc; background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(15,23,42,.18); }
.enterprise-mode .topbar { min-height: 88px; padding: 16px 28px; background: #fff; border-bottom: 1px solid #e2e8f0; }
.enterprise-mode .topbar h1 { font-size: 30px; letter-spacing: -.025em; margin-bottom: 4px; }
.enterprise-mode .topbar p { color: #64748b; }
.enterprise-mode .topbar .toggle { background: #f1f5f9; }
.enterprise-mode .topbar .toggle button.active { background: #fff; color: #0f172a; box-shadow: 0 0 0 1px #cbd5e1; }
.enterprise-mode .notification { background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; }
.enterprise-mode .top-actions > .avatar { border-radius: 6px; background: #0f172a !important; color: #fff; }
.profile-control { position: relative; }
.profile-trigger { min-height: 40px; padding: 3px 7px 3px 3px; border: 1px solid transparent; border-radius: 6px; background: transparent; color: #0f172a; display: flex; align-items: center; gap: 8px; cursor: pointer; text-align: start; }
.profile-trigger:hover, .profile-trigger[aria-expanded="true"] { border-color: #cbd5e1; background: #f8fafc; }
.profile-trigger .avatar { border-radius: 5px; background: #0f172a !important; color: #fff; }
.profile-trigger > span { display: flex; flex-direction: column; gap: 1px; }
.profile-trigger b { font-size: 10px; }.profile-trigger small { color: #64748b; font-size: 8px; }
.profile-trigger > svg { margin-inline-start: 3px; transform: rotate(90deg); color: #64748b; }
.profile-menu { position: absolute; z-index: 80; top: 47px; inset-inline-end: 0; width: 265px; padding: 8px; border: 1px solid #cbd5e1; border-radius: 7px; background: #fff; color: #0f172a; box-shadow: 0 12px 30px rgba(15,23,42,.14); }
.profile-menu-title { display: flex; flex-direction: column; gap: 2px; padding: 7px 8px 10px; border-bottom: 1px solid #e2e8f0; }
.profile-menu-title b { font-size: 11px; }.profile-menu-title small { color: #64748b; font-size: 9px; }
.profile-setting { min-height: 47px; padding: 7px 8px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.profile-setting > span { color: #475569; font-size: 10px; font-weight: 600; }
.profile-menu .toggle { background: #f1f5f9; }
.profile-menu .toggle button { padding: 5px 8px; border-radius: 4px; font-size: 9px; }
.profile-menu-link { width: 100%; min-height: 34px; padding: 0 8px; border: 0; border-top: 1px solid #e2e8f0; background: transparent; color: #334155; display: flex; align-items: center; justify-content: space-between; font-size: 10px; cursor: pointer; }
.profile-menu-link:hover { background: #f8fafc; }
.enterprise-page { padding: 18px 28px 24px; gap: 14px; background: #f8fafc; }
.enterprise-actions { min-height: 36px; display: flex; justify-content: space-between; align-items: center; }
.enterprise-actions > div { display: flex; align-items: center; gap: 8px; }
.record-count { color: #64748b; font-size: 12px; }
.outline-button, .dark-button {
  height: 34px; padding: 0 12px; border-radius: 5px; font-size: 12px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
}
.outline-button { border: 1px solid #cbd5e1; background: #fff; color: #0f172a; }
.outline-button:hover { background: #f1f5f9; border-color: #94a3b8; }
.dark-button { border: 1px solid #0f172a; background: #0f172a; color: #fff; }
.dark-button:hover { background: #1e293b; }
.metric-filters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.metric-filters button {
  min-height: 86px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; color: #0f172a; text-align: start; cursor: pointer; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto 1fr; gap: 3px 10px; position: relative;
}
.metric-filters button:hover { border-color: #94a3b8; }
.metric-filters button.selected { border-color: #0f172a; box-shadow: inset 3px 0 #0f172a; }
[dir="rtl"] .metric-filters button.selected { box-shadow: inset -3px 0 #0f172a; }
.metric-filters span { color: #475569; font-size: 11px; font-weight: 600; }
.metric-filters strong { grid-row: 1 / 3; grid-column: 2; align-self: center; font-size: 25px; letter-spacing: -.03em; }
.metric-filters small { color: #64748b; font-size: 10px; align-self: end; }
.metric-filters button:nth-child(2) strong { color: #059669; }
.metric-filters button:nth-child(3) strong { color: #d97706; }
.metric-filters button:nth-child(4) strong { color: #dc2626; }
.operations-card { flex: 1; min-height: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
.operations-toolbar { min-height: 56px; padding: 10px 12px; border-bottom: 1px solid #e2e8f0; display: grid; grid-template-columns: minmax(245px, 1fr) auto minmax(245px, 1fr); align-items: center; gap: 14px; }
.enterprise-search { height: 34px; max-width: 360px; display: flex; align-items: center; gap: 8px; border: 1px solid #cbd5e1; border-radius: 5px; padding: 0 9px; color: #64748b; background: #fff; }
.enterprise-search:focus-within { border-color: #0f172a; box-shadow: 0 0 0 1px #0f172a; }
.enterprise-search input { min-width: 0; width: 100%; border: 0; outline: 0; color: #0f172a; background: transparent; font-size: 11px; }
.enterprise-search input::placeholder { color: #94a3b8; }
.enterprise-search kbd { border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 5px; color: #64748b; background: #f8fafc; font: 9px -apple-system, BlinkMacSystemFont, sans-serif; }
.enterprise-tabs { justify-self: center; display: inline-flex; border: 1px solid #cbd5e1; border-radius: 6px; padding: 2px; background: #f8fafc; }
.enterprise-tabs button { height: 27px; padding: 0 10px; border: 0; border-radius: 4px; background: transparent; color: #475569; cursor: pointer; font-size: 10px; font-weight: 600; }
.enterprise-tabs button.selected { background: #0f172a; color: #fff; }
.bulk-actions { justify-self: end; display: flex; align-items: center; gap: 4px; visibility: hidden; }
.bulk-actions.visible { visibility: visible; }
.bulk-actions b { color: #475569; font-size: 10px; margin-inline-end: 4px; }
.bulk-actions button { height: 28px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #0f172a; font-size: 9px; font-weight: 600; cursor: pointer; }
.bulk-actions button:hover { background: #f1f5f9; border-color: #94a3b8; }
.enterprise-table { min-height: 0; overflow: auto; }
.operations-card > .enterprise-table { flex: 1; }
.enterprise-head, .enterprise-row { display: grid; grid-template-columns: 28px minmax(230px, 1.45fr) minmax(120px, .75fr) minmax(120px, .8fr) minmax(210px, 1.2fr) 92px; align-items: center; column-gap: 12px; padding: 0 14px; }
.enterprise-head { height: 34px; flex: 0 0 auto; background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
.enterprise-row { min-height: 51px; border-bottom: 1px solid #f1f5f9; color: #0f172a; font-size: 11px; }
.enterprise-row:last-child { border-bottom: 0; }
.enterprise-row:hover { background: #f8fafc; }
.enterprise-row.checked { background: #f1f5f9; box-shadow: inset 2px 0 #0f172a; }
.enterprise-head input, .enterprise-row > input { width: 14px; height: 14px; margin: 0; accent-color: #0f172a; cursor: pointer; }
.enterprise-profile { display: flex; align-items: center; gap: 9px; min-width: 0; }
.enterprise-profile .avatar { width: 28px; height: 28px; border-radius: 5px; background: #e2e8f0 !important; color: #334155; font-size: 9px; }
.enterprise-profile > span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.enterprise-profile b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }
.enterprise-profile small, .cell-subtitle { color: #64748b; font-size: 9px; }
.neutral-badge { width: max-content; display: inline-block; border-radius: 4px; padding: 3px 6px; background: #f1f5f9; color: #334155; font-style: normal; font-size: 9px; font-weight: 600; }
.cell-subtitle { display: block; margin-top: 3px; }
.plain-status { width: max-content; display: inline-flex; align-items: center; gap: 6px; color: #334155; font-size: 10px; font-weight: 600; }
.plain-status i { width: 7px; height: 7px; border-radius: 50%; background: #059669; }
.plain-status.sla-risk i, .plain-status.at-risk i { background: #d97706; }
.plain-status.offline i, .plain-status.inactive i { background: #dc2626; }
.plain-status.pending-review i, .plain-status.pending i { background: #d97706; }
.context-cell { color: #475569; font-size: 10px; }
.approve-button, .risk-button, .overflow-button { height: 28px; border-radius: 4px; font-size: 9px; font-weight: 700; cursor: pointer; }
.approve-button { border: 1px solid #0f172a; background: #0f172a; color: #fff; padding: 0 10px; }
.approve-button:hover { background: #1e293b; }
.risk-button { border: 1px solid #d97706; background: #fffbeb; color: #92400e; padding: 0 10px; }
.risk-button:hover { background: #fef3c7; }
.overflow-button { width: 30px; border: 1px solid #cbd5e1; background: #fff; color: #334155; display: grid; place-items: center; }
.overflow-button:hover { border-color: #64748b; background: #f1f5f9; }
.overflow-button svg { width: 14px; }
.facet-filters { justify-self: center; display: flex; align-items: center; gap: 7px; }
.facet-filters label { position: relative; }
.facet-filters label > span { position: absolute; top: -6px; inset-inline-start: 7px; z-index: 1; padding: 0 3px; background: #fff; color: #64748b; font-size: 7px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
.facet-filters select { height: 34px; min-width: 130px; padding: 0 28px 0 9px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #0f172a; font-size: 10px; font-weight: 600; }
.facet-filters select:focus { border-color: #0f172a; outline: 1px solid #0f172a; }
.agent-table .enterprise-head, .agent-table .enterprise-row { grid-template-columns: 28px minmax(235px, 1.45fr) minmax(100px, .7fr) minmax(85px, .55fr) minmax(110px, .72fr) minmax(190px, 1.1fr) 84px; }
.profile-link { width: max-content; max-width: 100%; padding: 0; border: 0; background: transparent; color: #0f172a; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; cursor: pointer; }
.profile-link:hover { text-decoration: underline; text-underline-offset: 2px; }
.profile-link svg { color: #64748b; }
.enterprise-profile small { display: flex; align-items: center; gap: 7px; }
.enterprise-profile small > span { min-width: 105px; }
.enterprise-profile code { min-width: 52px; padding-inline-start: 7px; border-inline-start: 1px solid #cbd5e1; color: #475569; font: 8px "JetBrains Mono", monospace; }
.plate-value { color: #334155; font: 600 10px "JetBrains Mono", monospace; letter-spacing: .02em; }
.table-pagination { flex: 0 0 43px; min-height: 43px; padding: 0 14px; border-top: 1px solid #e2e8f0; background: #fff; display: flex; align-items: center; justify-content: space-between; color: #64748b; font-size: 9px; }
.table-pagination > div { display: flex; gap: 3px; }
.table-pagination button { min-width: 28px; height: 26px; padding: 0 7px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; font-size: 9px; cursor: pointer; }
.table-pagination button:hover:not(:disabled), .table-pagination button.current { border-color: #0f172a; background: #0f172a; color: #fff; }
.table-pagination button:disabled { color: #94a3b8; cursor: not-allowed; }

/* Apply the same precision system to every operational view */
.enterprise-mode .page-body:not(.enterprise-page) { padding: 18px 28px 24px; gap: 14px; background: #f8fafc; }
.enterprise-mode .page-actions { min-height: 36px; }
.enterprise-mode .chips { gap: 4px; }
.enterprise-mode .chips button {
  height: 32px; padding: 0 10px; border: 1px solid transparent; border-radius: 5px; background: transparent; color: #475569; font-size: 10px; font-weight: 600;
}
.enterprise-mode .chips button:hover { background: #f1f5f9; color: #0f172a; }
.enterprise-mode .chips button.selected { border-color: #cbd5e1; background: #fff; color: #0f172a; box-shadow: none; }
.enterprise-mode .search { height: 34px; border-radius: 5px; background: #fff; color: #64748b; box-shadow: inset 0 0 0 1px #cbd5e1; }
.enterprise-mode .search input { color: #0f172a; font-size: 11px; }
.enterprise-mode .page-actions select { height: 34px; border-radius: 5px; background: #fff; color: #0f172a; box-shadow: inset 0 0 0 1px #cbd5e1; }
.enterprise-mode .primary, .enterprise-mode .secondary, .enterprise-mode .danger-button, .enterprise-mode .contact {
  min-height: 34px; border-radius: 5px; font-size: 11px; box-shadow: none;
}
.enterprise-mode .primary { background: #0f172a; color: #fff; }
.enterprise-mode .primary:hover { background: #1e293b; }
.enterprise-mode .secondary { border: 1px solid #cbd5e1; background: #fff; color: #0f172a; }
.enterprise-mode .secondary:hover { background: #f1f5f9; border-color: #94a3b8; }
.enterprise-mode .danger-button { border: 1px solid #dc2626; background: #fff; color: #b91c1c; }
.enterprise-mode .danger-button:hover { background: #fef2f2; }
.enterprise-mode .contact { border: 1px solid #a7f3d0; background: #ecfdf5; color: #047857; }
.enterprise-mode .stats { gap: 10px; }
.enterprise-mode .stat-card {
  min-height: 86px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; color: #0f172a; box-shadow: none;
}
.enterprise-mode .stat-card > span { color: #475569; font-size: 10px; font-weight: 600; }
.enterprise-mode .stat-card strong { margin: 7px 0 3px; color: #0f172a; font-size: 25px; }
.enterprise-mode .stat-card small { color: #64748b; font-size: 9px; }
.enterprise-mode .stat-card.hero { border-color: #0f172a; background: #fff; box-shadow: inset 3px 0 #0f172a; }
[dir="rtl"] .enterprise-mode .stat-card.hero { box-shadow: inset -3px 0 #0f172a; }
.enterprise-mode .stat-card.hero span, .enterprise-mode .stat-card.hero small { color: #475569; }
.enterprise-mode .table-card, .enterprise-mode .card { border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; box-shadow: none; }
.enterprise-mode .table-head { min-height: 34px; background: #f8fafc; color: #64748b; border-bottom: 1px solid #e2e8f0; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
.enterprise-mode .table-row { min-height: 51px; border-bottom-color: #f1f5f9; color: #0f172a; font-size: 11px; }
.enterprise-mode .table-row:hover { background: #f8fafc; box-shadow: inset 2px 0 #0f172a; }
[dir="rtl"] .enterprise-mode .table-row:hover { box-shadow: inset -2px 0 #0f172a; }
.enterprise-mode .table-row small { color: #64748b; }
.enterprise-mode .table-row .avatar { border-radius: 5px; background: #e2e8f0 !important; color: #334155; }
.enterprise-mode .mono { color: #0f172a; }
.enterprise-mode .status { border: 0; border-radius: 4px; padding: 4px 6px; background: #ecfdf5; color: #047857; font-size: 9px; font-weight: 600; }
.enterprise-mode .status.warning { background: #fffbeb; color: #b45309; }
.enterprise-mode .status.info { background: #eff6ff; color: #1d4ed8; }
.enterprise-mode .status.danger { background: #fef2f2; color: #b91c1c; }
.enterprise-mode .status.neutral { background: #f1f5f9; color: #475569; }
.enterprise-mode .row-actions button { height: 28px; min-width: 28px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; }
.enterprise-mode .row-actions button:hover { background: #f1f5f9; border-color: #94a3b8; }
.enterprise-mode .row-actions .text-button { color: #0f172a; }

.enterprise-mode .corridor { border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; }
.enterprise-mode .corridor > span { border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #475569; }
.enterprise-mode .corridor small { color: #64748b; }
.enterprise-mode .corridor.compact { border-radius: 4px; }

.enterprise-mode .map-layout { gap: 10px; grid-template-columns: 310px 1fr; }
.enterprise-mode .map-list { padding: 14px; }
.enterprise-mode .card-title h3 { color: #0f172a; }
.enterprise-mode .card-title p { color: #64748b; }
.enterprise-mode .map-job { border-top-color: #e2e8f0; color: #0f172a; }
.enterprise-mode .map-job:hover { background: #f8fafc; }
.enterprise-mode .map-job.selected:before { width: 2px; background: #0f172a; }
.enterprise-mode .map-job .avatar { border-radius: 4px; background: #e2e8f0 !important; color: #334155; }
.enterprise-mode .map-card { padding: 10px; }
.enterprise-mode .map-legend { color: #64748b; }
.enterprise-mode .map-graphic { border-radius: 6px; }
.enterprise-mode .map-expand { border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #0f172a; }
.enterprise-mode .fit-button { border: 1px solid #0f172a; border-radius: 5px; background: #0f172a; color: #fff; }
.map-job-head { align-items: flex-start; }
.map-job .person > span { display: flex; flex-direction: column; gap: 2px; }
.map-job .person > span b { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 10px; }
.map-job .person > span small { color: #64748b; font-size: 8px; }
.eta-block { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; color: #059669; }
.eta-block strong { font-size: 10px; line-height: 1; }
.eta-block small { color: #64748b; font-size: 8px; }
.eta-block.delayed { color: #b45309; }
.eta-block.delayed small { color: #d97706; }
.eta-block.stale { color: #b91c1c; }
.eta-block.stale small { color: #dc2626; }
.live-map-canvas > svg { transform: scale(1.035); transition: transform-origin .35s ease, transform .35s ease; }
.live-map-canvas .selected-route { stroke: #e3ff4d; stroke-width: 4; stroke-dasharray: 9 7; opacity: 1; }
.live-map-canvas .muted-route { stroke: #7d8791; stroke-width: 2; stroke-dasharray: 6 8; opacity: .18; }
.live-map-canvas .selected-pin .pin-halo { fill: #e3ff4d; opacity: .2; }
.live-map-canvas .selected-pin .pin-core { fill: #e3ff4d; }
.live-map-canvas .selected-pin .pin-pulse { fill: none; stroke: #e3ff4d; stroke-width: 1.5; opacity: .55; }
.live-map-canvas .muted-pin { opacity: .35; }
.live-map-canvas .muted-pin .pin-halo { fill: #94a3b8; opacity: .18; }
.live-map-canvas .muted-pin .pin-core { fill: #94a3b8; }
.map-popover { position: absolute; z-index: 4; width: 292px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 7px; background: #fff; color: #0f172a; box-shadow: 0 12px 28px rgba(15,23,42,.2); transform: translate(-50%, -108%); }
.popover-caret { position: absolute; bottom: -6px; left: 50%; width: 11px; height: 11px; border-right: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; background: #fff; transform: translateX(-50%) rotate(45deg); }
.map-popover.popover-below { transform: translate(-50%, 13%); }
.map-popover.popover-below .popover-caret { top: -6px; bottom: auto; border: 0; border-left: 1px solid #cbd5e1; border-top: 1px solid #cbd5e1; }
.popover-head { padding-bottom: 9px; border-bottom: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 2px; }
.popover-head > div { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.popover-head > div > b { font: 700 10px "JetBrains Mono", monospace; }
.popover-head strong { margin-top: 5px; font-size: 15px; letter-spacing: -.02em; }
.popover-head small { color: #64748b; font-size: 9px; }
.popover-agent { padding: 9px 0; display: flex; align-items: center; gap: 8px; }
.popover-agent .avatar { width: 29px; height: 29px; border-radius: 5px; background: #e2e8f0 !important; color: #334155; }
.popover-agent > div { display: flex; flex-direction: column; gap: 2px; }
.popover-agent b { font-size: 10px; }.popover-agent span { color: #64748b; font-size: 8px; }
.popover-route { padding: 8px; border: 1px solid #e2e8f0; border-radius: 5px; background: #f8fafc; display: grid; gap: 7px; }
.popover-route span { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.popover-route small { color: #64748b; font-size: 7px; text-transform: uppercase; letter-spacing: .04em; }
.popover-route b { overflow: hidden; color: #334155; font-size: 9px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.popover-actions { padding-top: 10px; display: grid; grid-template-columns: 1fr 1.15fr; gap: 6px; }
.popover-actions button { height: 30px; border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 9px; font-weight: 700; cursor: pointer; }
.call-agent { border: 1px solid #0f172a; background: #0f172a; color: #fff; }
.view-details { border: 1px solid #cbd5e1; background: #fff; color: #0f172a; }
.view-details:hover { background: #f1f5f9; }

.enterprise-mode .alert-feed { border-radius: 8px; }
.enterprise-mode .alert-row { padding: 14px; border-bottom-color: #e2e8f0; }
.enterprise-mode .alert-row h3 { color: #0f172a; }
.enterprise-mode .alert-row p, .enterprise-mode .response-card p { color: #64748b; }
.enterprise-mode .severity { border-radius: 5px; background: #fef2f2; color: #dc2626; }
.enterprise-mode .severity-warning { background: #fffbeb; color: #d97706; }
.enterprise-mode .severity-info { background: #eff6ff; color: #2563eb; }
.enterprise-mode .deep-link { color: #0f172a; }
.enterprise-mode .response-card { padding: 18px; }
.enterprise-mode .response-card > strong { margin: 18px 0 4px; font-size: 42px; }
.enterprise-mode .response-bars span { color: #64748b; }
.enterprise-mode .response-bars span:before { background: #e2e8f0; }
.enterprise-mode .empty-state { border-radius: 8px; }
.date-range-control { position: relative; height: 38px; min-width: 142px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #475569; display: flex; align-items: center; gap: 5px; }
.date-range-control select { height: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: #0f172a; font-size: 10px; font-weight: 600; cursor: pointer; }
.custom-date-range { position: absolute; z-index: 90; top: 43px; inset-inline-start: 0; width: 318px; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; box-shadow: 0 12px 30px rgba(15,23,42,.16); display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 8px; }
.custom-date-range > label { display: flex; flex-direction: column; gap: 4px; color: #64748b; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
.custom-date-range input { height: 30px; padding: 0 6px; border: 1px solid #cbd5e1; border-radius: 4px; color: #0f172a; background: #fff; font-size: 9px; }
.custom-date-range > span { padding-bottom: 7px; color: #94a3b8; font-size: 10px; }

.date-cell { color: #475569; font-size: 9px; font-weight: 600; white-space: nowrap; }
.quote-request-search { display: flex; align-items: center; gap: 7px; }
.quote-request-search .search { min-width: 180px; }
.quote-request-search .primary { white-space: nowrap; }
.request-details { display: block; margin-top: 3px; color: #64748b; font-size: 8px; }
.table-empty { padding: 30px 18px; color: #64748b; text-align: center; font-size: 11px; }
.request-date-strip { margin-top: 7px; display: flex; align-items: center; gap: 7px; color: #64748b; font-size: 8px; }
.request-date-strip b { color: #0f172a; font-size: 8px; }
.request-date-strip i { width: 3px; height: 3px; border-radius: 50%; background: #94a3b8; }

.enterprise-mode .modal-panel { border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #0f172a; box-shadow: 0 24px 70px rgba(15,23,42,.22); }
.enterprise-mode .modal-header, .enterprise-mode .modal-footer { background: #fff; border-color: #e2e8f0; }
.enterprise-mode .icon-button { border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; }

.enterprise-mode .field { color: #475569; }
.enterprise-mode .field input, .enterprise-mode .field select, .enterprise-mode .field textarea { border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #0f172a; box-shadow: none; }
.enterprise-mode .field input:focus, .enterprise-mode .field select:focus, .enterprise-mode .field textarea:focus { border-color: #0f172a; }

.enterprise-mode .profile-hero, .enterprise-mode .contact-card, .enterprise-mode .session-row, .enterprise-mode .permission-note { border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; }
.enterprise-mode .simple-body p, .enterprise-mode .modal-copy { color: #64748b; }

/* Business accounts operations hub */
.coc-settings-card { border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; overflow: hidden; flex: 0 0 auto; }
.coc-settings-heading { min-height: 70px; padding: 13px 16px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 11px; }
.coc-title-mark { width: 34px; height: 34px; border-radius: 6px; background: #0f172a; color: #e3ff4d; display: grid; place-items: center; flex: 0 0 auto; }
.coc-settings-heading > div:nth-child(2) { flex: 1; }
.settings-kicker { color: #64748b; font-size: 8px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
.coc-settings-heading h2 { margin: 2px 0 1px; font-size: 14px; letter-spacing: -.01em; }
.coc-settings-heading p { margin: 0; color: #64748b; font-size: 9px; }
.tenant-pill { padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 4px; color: #475569; background: #f8fafc; font: 700 8px "JetBrains Mono", monospace; }
.coc-settings-grid { min-height: 150px; display: grid; grid-template-columns: minmax(500px, 1.45fr) minmax(340px, 1fr); }
.coc-settings-grid > div:first-child { padding: 13px 16px; border-inline-end: 1px solid #e2e8f0; }
.template-dropzone { width: 100%; min-height: 84px; padding: 12px 14px; border: 1px dashed #94a3b8; border-radius: 6px; background: #f8fafc; color: #0f172a; display: flex; align-items: center; gap: 11px; text-align: start; cursor: pointer; }
.template-dropzone:hover, .template-dropzone.dragging { border-color: #0f172a; background: #f1f5f9; box-shadow: inset 0 0 0 1px #0f172a; }
.upload-icon { width: 32px; height: 32px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; display: grid; place-items: center; }
.template-dropzone > span:nth-child(2) { display: flex; flex: 1; flex-direction: column; gap: 3px; }
.template-dropzone strong { font-size: 10px; }.template-dropzone small { color: #64748b; font-size: 8px; }
.template-dropzone em { padding: 7px 9px; border-radius: 4px; background: #0f172a; color: #fff; font-size: 9px; font-style: normal; font-weight: 700; }
.fallback-note { margin-top: 9px; display: flex; align-items: center; gap: 7px; color: #047857; font-size: 8px; }
.fallback-note > span { display: flex; gap: 5px; }.fallback-note b { font-size: 8px; }
.template-message { margin: 7px 0 0; color: #475569; font-size: 8px; }
.active-template { min-height: 88px; padding: 11px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; display: flex; align-items: center; gap: 11px; }
.file-tile { width: 46px; height: 56px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; display: grid; place-items: center; color: #0f172a; font: 800 9px "JetBrains Mono", monospace; }
.template-meta { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.active-label { color: #047857; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.active-label i { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #10b981; margin-inline-end: 4px; }
.template-meta strong { max-width: 390px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }
.template-meta small { color: #64748b; font-size: 8px; }
.template-uploader { margin-top: 3px; display: flex; align-items: center; gap: 5px; color: #475569; font-size: 8px; }
.template-uploader .avatar { width: 18px; height: 18px; border-radius: 4px; background: #0f172a !important; font-size: 6px; }
.template-actions { display: grid; grid-template-columns: auto auto; gap: 5px; }
.template-actions button { height: 28px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #0f172a; display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 8px; font-weight: 700; cursor: pointer; }
.template-actions button:first-child { grid-column: 1 / -1; }.template-actions .remove-template { color: #b91c1c; border-color: #fecaca; }
.template-guidelines { background: #fff; }
.template-guidelines summary { min-height: 55px; padding: 12px 14px; list-style: none; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
.template-guidelines summary::-webkit-details-marker { display: none; }
.template-guidelines summary > span { display: flex; flex-direction: column; gap: 2px; }
.template-guidelines summary b { font-size: 10px; }.template-guidelines summary small { color: #64748b; font-size: 8px; }
.template-guidelines[open] summary svg { transform: rotate(90deg); }
.guidelines-body { max-height: 132px; overflow: auto; padding: 0 14px 12px; }
.guidelines-body > p { margin: 0 0 8px; padding: 7px 8px; border-inline-start: 2px solid #0f172a; background: #f8fafc; color: #475569; font-size: 8px; line-height: 1.45; }
.tag-group { margin-top: 7px; display: grid; grid-template-columns: 94px 1fr; gap: 7px; align-items: start; }
.tag-group > b { padding-top: 3px; color: #475569; font-size: 8px; }
.tag-group > div { display: flex; flex-wrap: wrap; gap: 3px; }
.tag-group code { padding: 2px 4px; border: 1px solid #e2e8f0; border-radius: 3px; background: #f8fafc; color: #334155; font-size: 7px; }
.tag-note { display: block; margin-top: 8px; color: #64748b; font-size: 7px; }
.sample-template-banner { margin: 0 0 10px; padding: 10px 12px; border: 1px solid #c7d2fe; border-radius: 6px; background: #eef2ff; display: flex; align-items: center; gap: 10px; }
.sample-template-copy { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.sample-template-copy b { font-size: 9px; color: #1e1b4b; }
.sample-template-copy span { font-size: 8px; color: #4338ca; line-height: 1.45; }
.sample-download-button { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; padding: 6px 11px; border-radius: 5px; border: 1px solid #4f46e5; background: #4f46e5; color: #fff; font-size: 9px; font-weight: 600; cursor: pointer; transition: background 0.12s, border-color 0.12s; white-space: nowrap; }
.sample-download-button:hover { background: #4338ca; border-color: #4338ca; }
.settings-page { gap: 0; }
.settings-shell { min-height: 100%; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; overflow: hidden; }
.settings-tabs { min-height: 66px; padding: 8px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; }
.settings-tabs > button { min-width: 0; padding: 8px 10px; border: 1px solid transparent; border-radius: 6px; background: transparent; color: #475569; display: grid; grid-template-columns: 29px 1fr 12px; align-items: center; gap: 8px; text-align: start; cursor: pointer; }
.settings-tabs > button:hover { border-color: #cbd5e1; background: #fff; }
.settings-tabs > button.active { border-color: #0f172a; background: #fff; color: #0f172a; box-shadow: inset 0 -2px #0f172a; }
.settings-tab-icon { width: 29px; height: 29px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; display: grid; place-items: center; }
.settings-tabs > button.active .settings-tab-icon { border-color: #0f172a; background: #0f172a; color: #e3ff4d; }
.settings-tabs > button > span:nth-child(2) { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.settings-tabs b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; }
.settings-tabs small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #64748b; font-size: 8px; }
.settings-content { padding: 18px; }
.settings-section-heading { min-height: 55px; margin-bottom: 13px; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
.settings-section-heading h2 { margin: 3px 0 2px; color: #0f172a; font-size: 16px; letter-spacing: -.015em; }
.settings-section-heading p { margin: 0; color: #64748b; font-size: 9px; }
.settings-access-badge { padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 4px; background: #f8fafc; color: #475569; font-size: 8px; font-weight: 700; }
.settings-content .coc-settings-grid { grid-template-columns: minmax(430px,1.3fr) minmax(300px,1fr); }
.settings-audit-note { margin-top: 12px; padding: 11px 13px; border: 1px solid #bbf7d0; border-radius: 6px; background: #f0fdf4; color: #047857; display: flex; align-items: flex-start; gap: 9px; }
.settings-audit-note b { font-size: 9px; }.settings-audit-note p { margin: 2px 0 0; color: #15803d; font-size: 8px; }
.settings-form-card { border: 1px solid #e2e8f0; border-radius: 7px; overflow: hidden; }
.settings-form-card > .settings-section-heading { margin: 0; padding: 16px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; }
.settings-form-grid { padding: 16px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
.settings-form-footer { padding: 12px 16px; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; }
.notification-settings-list { padding: 5px 16px; }
.notification-settings-list label { min-height: 60px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; }
.notification-settings-list label:last-child { border-bottom: 0; }
.notification-settings-list label > span { display: flex; flex-direction: column; gap: 3px; }
.notification-settings-list b { font-size: 10px; }.notification-settings-list small { color: #64748b; font-size: 8px; }
.notification-settings-list input { width: 30px; height: 17px; accent-color: #0f172a; cursor: pointer; }
.business-metrics button:nth-child(2) strong { color: #0f172a; }
.business-metrics button:nth-child(3) strong { color: #b45309; font-size: 21px; }
.business-metrics button:nth-child(4) strong { color: #d97706; }
.business-toolbar { grid-template-columns: 1fr auto 1fr; }
.table-result-count { justify-self: end; color: #64748b; font-size: 10px; }
.business-accounts-table .enterprise-head, .business-accounts-table .enterprise-row { grid-template-columns: minmax(220px, 1.35fr) minmax(95px, .6fr) minmax(145px, .9fr) minmax(135px, .85fr) minmax(135px, .8fr) 44px; }
.business-account-row { cursor: pointer; }
.business-account-row:hover { box-shadow: inset 2px 0 #0f172a; }
.active-jobs-link { width: max-content; padding: 4px 7px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #0f172a; display: flex; align-items: center; gap: 5px; font-size: 9px; font-weight: 700; cursor: pointer; }
.active-jobs-link:hover { border-color: #0f172a; background: #f8fafc; }
.financial-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
.financial-cell b { font-size: 10px; }
.financial-cell em { padding: 2px 5px; border-radius: 3px; background: #fffbeb; color: #b45309; font-size: 8px; font-style: normal; font-weight: 700; }
.financial-cell em.overdue { background: #fef2f2; color: #b91c1c; }
.financial-cell em.paid { background: #ecfdf5; color: #047857; }
.account-drawer { position: fixed; z-index: 110; inset-block: 0; inset-inline-end: 0; width: min(780px, 82vw); background: #fff; color: #0f172a; box-shadow: -24px 0 60px rgba(15,23,42,.2); display: flex; flex-direction: column; animation: drawer-in .22s ease-out; }
@keyframes drawer-in { from { transform: translateX(24px); opacity: .65; } to { transform: translateX(0); opacity: 1; } }
[dir="rtl"] .account-drawer { box-shadow: 24px 0 60px rgba(15,23,42,.2); animation-name: drawer-in-rtl; }
@keyframes drawer-in-rtl { from { transform: translateX(-24px); opacity: .65; } to { transform: translateX(0); opacity: 1; } }
.drawer-header { min-height: 88px; padding: 15px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: flex-start; justify-content: space-between; }
.drawer-company { display: flex; align-items: center; gap: 12px; }
.drawer-company > .avatar { width: 46px; height: 46px; border-radius: 6px; background: #e2e8f0 !important; color: #334155; font-size: 12px; }
.drawer-company h2 { margin: 3px 0 5px; font-size: 20px; letter-spacing: -.02em; }
.drawer-company > div > div { display: flex; align-items: center; gap: 7px; }
.drawer-company em { color: #475569; font-size: 9px; font-style: normal; font-weight: 600; }
.drawer-tabs { flex: 0 0 42px; padding: 0 20px; border-bottom: 1px solid #e2e8f0; display: flex; gap: 20px; }
.drawer-tabs button { position: relative; border: 0; background: transparent; color: #64748b; font-size: 10px; font-weight: 600; cursor: pointer; }
.drawer-tabs button.active { color: #0f172a; }
.drawer-tabs button.active:after { content: ""; position: absolute; inset-inline: 0; bottom: -1px; height: 2px; background: #0f172a; }
.drawer-body { flex: 1; overflow: auto; padding: 18px 20px 28px; }
.drawer-section-title { min-height: 35px; margin: 2px 0 9px; display: flex; align-items: center; justify-content: space-between; }
.drawer-section-title h3 { margin: 0; font-size: 13px; }
.drawer-section-title p { margin: 2px 0 0; color: #64748b; font-size: 9px; }
.text-action { border: 0; background: transparent; color: #0f172a; font-size: 9px; font-weight: 700; cursor: pointer; }
.live-shipments { border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; }
.shipment-row { min-height: 58px; padding: 7px 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: minmax(165px, 1.15fr) minmax(135px, .9fr) 90px 126px; gap: 10px; align-items: center; }
.shipment-row:last-child { border-bottom: 0; }
.shipment-row > div:first-child, .shipment-row .person > span { display: flex; flex-direction: column; gap: 3px; }
.shipment-row > div:first-child button { width: max-content; padding: 0; border: 0; background: transparent; color: #0f172a; font: 700 9px "JetBrains Mono", monospace; }
.shipment-row > div:first-child span, .shipment-row .person small { color: #64748b; font-size: 8px; }
.shipment-row .avatar { width: 26px; height: 26px; border-radius: 4px; background: #e2e8f0 !important; color: #334155; }
.shipment-row .person b { font-size: 9px; }
.shipment-row > div:last-child { display: flex; gap: 4px; }
.icon-action { height: 27px; padding: 0 6px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; display: flex; align-items: center; gap: 4px; font-size: 8px; font-weight: 600; cursor: pointer; }
.analytics-grid { margin: 14px 0 17px; display: grid; grid-template-columns: 1.35fr 1fr; gap: 10px; }
.drawer-card { min-height: 145px; padding: 13px; border: 1px solid #e2e8f0; border-radius: 6px; }
.drawer-card-head { display: flex; align-items: flex-start; justify-content: space-between; }
.drawer-card-head > span, .sla-card > span { color: #475569; font-size: 9px; font-weight: 700; }
.drawer-card-head b { font-size: 15px; }
.drawer-card-head small { color: #64748b; font-size: 8px; font-weight: 500; }
.mini-bars { height: 69px; margin: 10px 0 5px; display: flex; align-items: end; gap: 4px; }
.mini-bars i { flex: 1; min-height: 4px; border-radius: 1px 1px 0 0; background: #cbd5e1; }
.mini-bars i:nth-last-child(-n+3) { background: #334155; }
.drawer-card p { margin: 0; color: #64748b; font-size: 8px; }
.sla-card > div { min-height: 87px; display: flex; align-items: center; justify-content: space-between; }
.sla-card strong { font-size: 30px; letter-spacing: -.04em; }
.sla-ring { width: 56px; height: 56px; border-radius: 50%; background: conic-gradient(#059669 0 98.4%,#e2e8f0 98.4%); display: grid; place-items: center; }
.sla-ring i { width: 43px; height: 43px; border-radius: 50%; background: #fff; }
.contacts-list { border: 1px solid #e2e8f0; border-radius: 6px; }
.contacts-list > div { min-height: 48px; padding: 6px 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: 27px 1fr 28px 28px; align-items: center; gap: 8px; }
.contacts-list > div:last-child { border-bottom: 0; }
.contacts-list .avatar { width: 27px; height: 27px; border-radius: 4px; background: #e2e8f0 !important; color: #334155; }
.contacts-list > div > span { display: flex; flex-direction: column; gap: 2px; }
.contacts-list b { font-size: 9px; }
.contacts-list small { color: #64748b; font-size: 8px; }
.contacts-list button { width: 27px; height: 27px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; display: grid; place-items: center; cursor: pointer; }
.email-icon { font-size: 12px; font-weight: 700; }
.history-controls { margin-bottom: 14px; display: grid; grid-template-columns: 1fr 135px 130px; gap: 7px; }
.history-controls > input, .history-controls > select { height: 34px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #334155; font-size: 9px; }
.drawer-table { border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; }
.drawer-table-head, .drawer-table-row { display: grid; align-items: center; gap: 9px; padding: 0 10px; }
.drawer-table-head { min-height: 31px; background: #f8fafc; color: #64748b; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
.drawer-table-row { min-height: 49px; border-top: 1px solid #f1f5f9; font-size: 9px; }
.history-table .drawer-table-head, .history-table .drawer-table-row { grid-template-columns: 80px 1.5fr 105px 80px 105px; }
.invoice-table .drawer-table-head, .invoice-table .drawer-table-row { grid-template-columns: 105px 1.15fr 100px 75px 110px; }
.drawer-table-row > b { font: 700 9px "JetBrains Mono", monospace; }
.drawer-table-row > small { color: #64748b; }
.drawer-table-row > div { display: flex; gap: 4px; }
.drawer-table-row > div button { height: 25px; padding: 0 6px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; display: flex; align-items: center; gap: 3px; font-size: 8px; cursor: pointer; }
.exception-list { border: 1px solid #e2e8f0; border-radius: 6px; }
.exception-list > div { min-height: 43px; padding: 0 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: 70px 75px 1fr 50px; align-items: center; gap: 7px; font-size: 9px; }
.exception-list > div:last-child { border: 0; }
.exception-list small { color: #64748b; text-align: end; }
.credit-card { margin-bottom: 15px; padding: 14px; border: 1px solid #cbd5e1; border-radius: 6px; display: grid; grid-template-columns: 1fr auto; gap: 5px; }
.credit-card > div:first-child { display: flex; flex-direction: column; gap: 4px; }
.credit-card span { color: #475569; font-size: 9px; font-weight: 700; }
.credit-card strong { font-size: 18px; }
.credit-card strong small { color: #64748b; font-size: 9px; font-weight: 500; }
.credit-card > b { color: #b45309; font-size: 10px; }
.credit-track { grid-column: 1/-1; height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
.credit-track i { display: block; width: 84%; height: 100%; background: #d97706; }
.credit-card p { grid-column: 1/-1; margin: 2px 0 0; color: #64748b; font-size: 8px; }
.finance-details { margin-top: 14px; display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
.finance-details span { padding: 10px; border: 1px solid #e2e8f0; border-radius: 5px; display: flex; flex-direction: column; gap: 4px; }
.finance-details small { color: #64748b; font-size: 8px; }
.finance-details b { font-size: 9px; }
.contract-summary { padding: 13px; border: 1px solid #cbd5e1; border-radius: 6px; display: grid; grid-template-columns: 1fr 1.4fr 1fr auto; align-items: center; gap: 12px; margin-bottom: 16px; }
.contract-summary > div { display: flex; flex-direction: column; gap: 5px; }
.contract-summary > div > span { color: #64748b; font-size: 8px; }
.contract-summary > div > b { font-size: 9px; }
.rules-list, .documents-list { border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 16px; }
.rules-list > div { min-height: 58px; padding: 9px 11px; border-bottom: 1px solid #f1f5f9; display: flex; gap: 10px; }
.rules-list > div:last-child, .documents-list > div:last-child { border: 0; }
.rule-icon { width: 25px; height: 25px; flex: 0 0 auto; border-radius: 4px; background: #f1f5f9; color: #475569; display: grid; place-items: center; font: 700 8px "JetBrains Mono",monospace; }
.rules-list b { font-size: 9px; }
.rules-list p { margin: 3px 0 0; color: #64748b; font-size: 9px; line-height: 1.45; }
.documents-list > div { min-height: 52px; padding: 7px 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: 31px 1fr 28px 28px; align-items: center; gap: 8px; }
.pdf-icon { width: 29px; height: 31px; border-radius: 3px; background: #fef2f2; color: #b91c1c; display: grid; place-items: center; font-size: 7px; font-weight: 800; }
.documents-list > div > span:nth-child(2) { display: flex; flex-direction: column; gap: 3px; }
.documents-list b { font-size: 9px; }
.documents-list small { color: #64748b; font-size: 8px; }
.documents-list button { width: 27px; height: 27px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; display: grid; place-items: center; }

/* Agent profile slide-over */
.agent-row { cursor: pointer; }
.agent-drawer { width: min(820px, 84vw); }
.agent-drawer-header { min-height: 108px; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: grid; grid-template-columns: 68px 1fr auto 34px; align-items: center; gap: 13px; }
.agent-photo { width: 66px; height: 66px; border-radius: 7px; object-fit: cover; object-position: center 28%; background: #e2e8f0; }
.agent-identity h2 { margin: 3px 0 4px; font-size: 20px; letter-spacing: -.025em; }
.agent-identity > div { display: flex; align-items: center; gap: 8px; }
.agent-identity code { color: #334155; font: 600 9px "JetBrains Mono", monospace; }
.agent-identity > div > span { color: #64748b; font-size: 9px; }
.agent-tags { margin-top: 7px; }
.agent-tags em { padding: 4px 6px; border-radius: 4px; background: #f1f5f9; color: #334155; font-size: 8px; font-style: normal; font-weight: 600; }
.agent-quick-actions { display: flex; align-items: center; gap: 6px; }
.drawer-close { align-self: start; }
.agent-kpis { flex: 0 0 57px; padding: 8px 20px; border-bottom: 1px solid #e2e8f0; display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
.agent-kpis > div { padding: 0 12px; border-inline-start: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
.agent-kpis > div:first-child { padding-inline-start: 0; border: 0; }
.agent-kpis span { color: #64748b; font-size: 8px; font-weight: 600; }
.agent-kpis b { font-size: 15px; letter-spacing: -.02em; }
.agent-kpis i { color: #d97706; font-style: normal; font-size: 11px; }
.agent-tabs { justify-content: space-between; gap: 8px; }
.agent-tabs button { white-space: nowrap; font-size: 9px; }
.active-delivery-card { padding: 14px; border: 1px solid #cbd5e1; border-radius: 6px; }
.active-delivery-head { display: flex; align-items: flex-start; justify-content: space-between; }
.active-delivery-head > div { display: flex; flex-direction: column; gap: 2px; }
.active-delivery-head b { font: 700 10px "JetBrains Mono", monospace; }
.active-delivery-head span { color: #64748b; font-size: 8px; }
.active-delivery-head strong { color: #047857; font-size: 15px; }
.delivery-route { margin: 14px 0 11px; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.delivery-route > span { position: relative; display: grid; grid-template-columns: 13px 1fr; gap: 6px; }
.delivery-route i { width: 9px; height: 9px; margin-top: 3px; border: 2px solid #334155; border-radius: 50%; }
.delivery-route > span:first-child:after { content: ""; position: absolute; top: 7px; inset-inline-start: 11px; width: calc(100% + 15px); border-top: 1px dashed #cbd5e1; }
.delivery-route > span > div { position: relative; z-index: 1; background: #fff; }
.delivery-route small { display: block; color: #64748b; font-size: 8px; margin-bottom: 3px; }
.delivery-route b { font-size: 9px; }
.eta-progress { display: grid; grid-template-columns: 1fr auto; gap: 9px; align-items: center; }
.eta-progress > div { height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
.eta-progress i { display: block; width: 62%; height: 100%; background: #059669; }
.eta-progress span { color: #64748b; font-size: 8px; }
.delivery-actions { margin-top: 12px; display: flex; justify-content: flex-end; gap: 6px; }
.agent-live-grid { margin-top: 12px; display: grid; grid-template-columns: 1.35fr .8fr; gap: 10px; }
.agent-mini-map { min-height: 190px; position: relative; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; }
.agent-mini-map svg { width: 100%; height: 100%; }
.agent-mini-map button { position: absolute; inset-inline-end: 9px; bottom: 9px; height: 28px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #0f172a; display: flex; align-items: center; gap: 5px; font-size: 8px; font-weight: 700; cursor: pointer; }
.shift-card { padding: 14px; border: 1px solid #e2e8f0; border-radius: 6px; }
.shift-card > strong { display: block; margin: 8px 0 13px; font-size: 27px; letter-spacing: -.04em; }
.shift-card > div { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; }
.shift-card > div span { display: flex; flex-direction: column; gap: 3px; }
.shift-card small { color: #64748b; font-size: 7px; }.shift-card b { font-size: 9px; }
.shift-card p { margin: 17px 0 0; padding-top: 10px; border-top: 1px solid #e2e8f0; color: #64748b; font-size: 8px; }
.shift-card p i { display: inline-block; width: 6px; height: 6px; margin-inline-end: 5px; border-radius: 50%; background: #059669; }
.agent-history-controls { grid-template-columns: 1fr 112px 112px 125px; }
.agent-history-table .drawer-table-head, .agent-history-table .drawer-table-row { grid-template-columns: 76px 1.15fr 100px 75px 86px 65px; }
.reason-tag { padding: 3px 5px; border-radius: 3px; background: #fffbeb; color: #b45309; font-size: 8px; font-style: normal; font-weight: 600; }
.performance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
.score-card { padding: 13px; border: 1px solid #e2e8f0; border-radius: 6px; }
.score-card > span { color: #475569; font-size: 9px; font-weight: 600; }
.score-card strong { display: block; margin: 8px 0; font-size: 24px; letter-spacing: -.03em; }
.score-card > div { height: 5px; margin-bottom: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
.score-card > div i { display: block; height: 100%; background: #059669; }
.score-card small { color: #64748b; font-size: 8px; }
.rating-summary { color: #b45309; font-size: 9px; }
.feedback-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 15px; }
.feedback-list blockquote { margin: 0; padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; }
.feedback-list blockquote > div { display: flex; justify-content: space-between; gap: 10px; }
.feedback-list b { font-size: 9px; line-height: 1.5; }.feedback-list span { flex: 0 0 auto; color: #b45309; font-size: 9px; }
.feedback-list p { margin: 7px 0 0; color: #64748b; font-size: 8px; }
.safety-list { margin-bottom: 14px; border: 1px solid #e2e8f0; border-radius: 6px; }
.safety-list > div { min-height: 49px; padding: 7px 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: 28px 1fr 55px; align-items: center; gap: 8px; }
.safety-list > div:last-child { border: 0; }
.safety-icon { width: 27px; height: 27px; border-radius: 4px; background: #f1f5f9; color: #334155; display: grid; place-items: center; font: 700 8px "JetBrains Mono", monospace; }
.safety-icon.warning { background: #fffbeb; color: #b45309; }
.safety-list b { font-size: 9px; }.safety-list p { margin: 2px 0 0; color: #64748b; font-size: 8px; }.safety-list small { color: #64748b; font-size: 8px; text-align: end; }
.compliance-list { border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 15px; }
.compliance-list > div { min-height: 54px; padding: 7px 10px; border-bottom: 1px solid #f1f5f9; display: grid; grid-template-columns: 29px 1fr 90px 48px; align-items: center; gap: 8px; }
.compliance-list > div:last-child { border: 0; }
.document-icon { width: 28px; height: 28px; border-radius: 4px; background: #f1f5f9; color: #475569; display: grid; place-items: center; }
.compliance-list > div > span:nth-child(2) { display: flex; flex-direction: column; gap: 2px; }
.compliance-list b { font-size: 9px; }.compliance-list small { color: #64748b; font-size: 8px; }
.compliance-list button { height: 26px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; display: flex; align-items: center; gap: 3px; font-size: 8px; }
.financial-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-bottom: 15px; }
.financial-kpis > div { padding: 13px; border: 1px solid #e2e8f0; border-radius: 6px; display: flex; flex-direction: column; gap: 5px; }
.financial-kpis span { color: #475569; font-size: 9px; font-weight: 600; }
.financial-kpis strong { font-size: 22px; letter-spacing: -.03em; }
.financial-kpis small { color: #64748b; font-size: 8px; }
.financial-kpis .cash-holding { border-color: #fcd34d; background: #fffbeb; }
.financial-kpis .cash-holding strong { color: #b45309; }
.earnings-breakdown { border: 1px solid #e2e8f0; border-radius: 6px; }
.earnings-breakdown span { min-height: 38px; padding: 0 11px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; }
.earnings-breakdown b { color: #475569; font-size: 9px; font-weight: 500; }
.earnings-breakdown strong { font-size: 9px; }
.earnings-breakdown .earnings-total { border: 0; background: #f8fafc; }
.earnings-breakdown .earnings-total b, .earnings-breakdown .earnings-total strong { color: #0f172a; font-size: 10px; font-weight: 700; }

/* Create job and quote request conversion drawer */
.job-form-drawer { width: min(920px, 90vw); }
.job-form-header { min-height: 93px; padding: 17px 22px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: flex-start; justify-content: space-between; }
.job-form-header h2 { margin: 3px 0 4px; font-size: 21px; letter-spacing: -.025em; }
.job-form-header p { margin: 0; color: #64748b; font-size: 9px; }
.job-form-body { flex: 1; overflow-y: auto; background: #f8fafc; }
.job-form-section { padding: 18px 22px; border-bottom: 1px solid #e2e8f0; background: #fff; }
.job-section-heading { margin-bottom: 13px; display: flex; align-items: flex-start; gap: 9px; }
.job-section-heading > span { width: 23px; height: 23px; flex: 0 0 auto; border-radius: 4px; background: #0f172a; color: #fff; display: grid; place-items: center; font: 700 8px "JetBrains Mono", monospace; }
.job-section-heading h3 { margin: 1px 0 2px; font-size: 12px; }
.job-section-heading p { margin: 0; color: #64748b; font-size: 8px; }
.pricing-grid { display: grid; grid-template-columns: 1.05fr 1.15fr 1.05fr .95fr; gap: 9px; align-items: end; }
.money-input { display: grid; grid-template-columns: 58px 1fr; }
.money-input select { position: relative; z-index: 1; border-start-end-radius: 0 !important; border-end-end-radius: 0 !important; background: #f8fafc !important; font-weight: 700 !important; }
.money-input input { margin-inline-start: -1px; border-start-start-radius: 0 !important; border-end-start-radius: 0 !important; }
.margin-card { min-height: 57px; padding: 8px 10px; border: 1px solid #a7f3d0; border-radius: 5px; background: #ecfdf5; display: grid; grid-template-columns: 1fr auto; gap: 2px 7px; }
.margin-card span { grid-column: 1/-1; color: #047857; font-size: 8px; font-weight: 600; }
.margin-card strong { color: #065f46; font-size: 13px; }
.margin-card em { align-self: center; color: #047857; font-size: 8px; font-style: normal; font-weight: 700; }
.margin-card > div { grid-column: 1/-1; height: 3px; margin-top: 2px; border-radius: 2px; background: #a7f3d0; overflow: hidden; }
.margin-card i { display: block; height: 100%; background: #059669; }
.auto-price { margin-top: 8px; padding: 0; border: 0; background: transparent; color: #0f172a; font-size: 8px; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
.route-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #e2e8f0; border-bottom: 1px solid #e2e8f0; }
.route-form-section { padding: 18px 22px; background: #fff; }
.route-form-section.pickup { box-shadow: inset 3px 0 #334155; }
.route-form-section.dropoff { box-shadow: inset 3px 0 #64748b; }
[dir="rtl"] .route-form-section.pickup { box-shadow: inset -3px 0 #334155; }
[dir="rtl"] .route-form-section.dropoff { box-shadow: inset -3px 0 #64748b; }
.leg-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.location-input { display: grid; grid-template-columns: 27px 1fr auto; align-items: center; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #64748b; overflow: hidden; }
.location-input > svg { margin: auto; }
.location-input input { min-width: 0; margin: -1px 0; padding-inline: 0 !important; border: 0 !important; box-shadow: none !important; }
.location-input button { align-self: stretch; padding: 0 9px; border: 0; border-inline-start: 1px solid #e2e8f0; background: #f8fafc; color: #334155; font-size: 8px; font-weight: 700; cursor: pointer; }
.cargo-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 9px; }
.cargo-grid > .field.wide { grid-column: 1 / 3; }
.dimension-inputs { display: grid; grid-template-columns: 1fr 13px 1fr 13px 1fr; align-items: center; }
.dimension-inputs span { color: #64748b; text-align: center; font-size: 9px; }
.handling-field { grid-column: 3 / -1; display: flex; flex-direction: column; gap: 6px; }
.handling-field > span { color: #475569; font-size: 10px; }
.handling-field > div { min-height: 35px; padding: 5px 7px; border: 1px solid #cbd5e1; border-radius: 5px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 12px; }
.handling-field label { color: #334155; display: flex; align-items: center; gap: 4px; font-size: 8px; font-weight: 600; }
.handling-field input { width: 13px; height: 13px; accent-color: #0f172a; }
.attachment-drop { min-height: 76px; padding: 12px; border: 1px dashed #94a3b8; border-radius: 6px; background: #f8fafc; display: flex; align-items: center; justify-content: center; gap: 9px; cursor: pointer; }
.attachment-drop:hover { border-color: #0f172a; background: #f1f5f9; }
.attachment-drop input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.attachment-drop > span { width: 30px; height: 30px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #334155; display: grid; place-items: center; }
.attachment-drop > div { display: flex; flex-direction: column; gap: 3px; }
.attachment-drop b { font-size: 9px; }
.attachment-drop small { color: #64748b; font-size: 8px; }
.attached-file { min-height: 43px; margin-top: 7px; padding: 5px 8px; border: 1px solid #e2e8f0; border-radius: 5px; display: grid; grid-template-columns: 29px 1fr 27px; align-items: center; gap: 8px; }
.attached-file > div { display: flex; flex-direction: column; gap: 2px; }
.attached-file b { font-size: 8px; }.attached-file small { color: #64748b; font-size: 7px; }
.attached-file button { width: 26px; height: 26px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #64748b; display: grid; place-items: center; }
.job-form-footer { flex: 0 0 61px; padding: 10px 22px; border-top: 1px solid #cbd5e1; background: #fff; display: flex; align-items: center; justify-content: flex-end; gap: 7px; }
.job-form-footer > div { margin-inline-end: auto; display: flex; flex-direction: column; gap: 2px; }
.job-form-footer span { color: #64748b; font-size: 8px; }
.job-form-footer strong { font-size: 13px; }
.job-form-footer > div small { color: #475569; font-size: 8px; }
.quote-request-agent-selector { margin-top: 14px; padding-top: 13px; border-top: 1px solid #e2e8f0; }
.quote-request-agent-heading { margin-bottom: 8px; display: flex; align-items: flex-start; justify-content: space-between; }
.quote-request-agent-heading h4 { margin: 0 0 2px; font-size: 10px; }
.quote-request-agent-heading p { margin: 0; color: #64748b; font-size: 8px; }
.quote-request-agent-heading > button { padding: 0; border: 0; background: transparent; color: #b91c1c; font-size: 8px; font-weight: 700; cursor: pointer; }
.quote-request-agent-search { height: 34px; padding: 0 9px; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #64748b; display: flex; align-items: center; gap: 7px; }
.quote-request-agent-search:focus-within { border-color: #0f172a; box-shadow: 0 0 0 1px #0f172a; }
.quote-request-agent-search input { min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; color: #0f172a; font-size: 9px; }
.quote-request-agent-options { margin-top: 7px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 6px; }
.quote-request-agent-options > button { min-height: 52px; padding: 7px; border: 1px solid #e2e8f0; border-radius: 5px; background: #fff; color: #0f172a; display: grid; grid-template-columns: 29px minmax(105px,1fr) auto; grid-template-rows: auto auto; align-items: center; gap: 2px 7px; text-align: start; cursor: pointer; position: relative; }
.quote-request-agent-options > button:hover { border-color: #94a3b8; background: #f8fafc; }
.quote-request-agent-options > button.selected { border-color: #0f172a; box-shadow: inset 2px 0 #0f172a; background: #f8fafc; }
[dir="rtl"] .quote-request-agent-options > button.selected { box-shadow: inset -2px 0 #0f172a; }
.quote-request-agent-options .avatar { grid-row: 1 / 3; width: 29px; height: 29px; border-radius: 5px; background: #e2e8f0 !important; color: #334155; font-size: 8px; }
.quote-request-agent-options > button > span:nth-child(2) { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.quote-request-agent-options b { overflow: hidden; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.quote-request-agent-options small { overflow: hidden; color: #64748b; font-size: 7px; text-overflow: ellipsis; white-space: nowrap; }
.quote-request-agent-status { width: max-content; display: flex; align-items: center; gap: 4px; color: #475569; font-size: 7px; font-weight: 700; }
.quote-request-agent-status i { width: 5px; height: 5px; border-radius: 50%; background: #64748b; }
.quote-request-agent-status.available { color: #047857; }
.quote-request-agent-status.available i { background: #059669; }
.quote-request-agent-status.sla-risk { color: #b45309; }
.quote-request-agent-status.sla-risk i { background: #d97706; }
.quote-request-agent-status.offline { color: #b91c1c; }
.quote-request-agent-status.offline i { background: #dc2626; }
.quote-request-agent-options em { grid-column: 2 / 4; color: #64748b; font-size: 7px; font-style: normal; }
.agent-selected-check { position: absolute; top: 4px; inset-inline-end: 4px; width: 17px; height: 17px; border-radius: 50%; background: #0f172a; color: #fff; display: grid; place-items: center; }

/* Jobs inline agent assignment and row actions */

/* Agent registration */
.add-agent-backdrop { position: fixed; z-index: 200; inset: 0; padding: 24px; background: rgba(2,6,23,.56); backdrop-filter: blur(4px); display: grid; place-items: center; }
.add-agent-modal { width: min(820px,calc(100vw - 48px)); max-height: calc(100vh - 48px); border: 1px solid #cbd5e1; border-radius: 12px; background: #fff; color: #0f172a; box-shadow: 0 28px 80px rgba(15,23,42,.3); display: flex; flex-direction: column; overflow: hidden; }
.add-agent-header { flex: 0 0 auto; padding: 17px 20px 14px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
.add-agent-header h2 { margin: 3px 0 3px; font-size: 20px; font-weight: 600; letter-spacing: -.025em; }
.add-agent-header p { margin: 0; color: #64748b; font-size: 10px; }
.add-agent-header .icon-button { flex: 0 0 auto; }
.add-agent-body { min-height: 0; overflow: auto; padding: 0 20px; }
.agent-form-section { padding: 16px 0 17px; border-bottom: 1px solid #e2e8f0; }
.agent-form-section:last-child { border-bottom: 0; }
.agent-form-section-title { margin-bottom: 12px; display: flex; align-items: flex-start; gap: 9px; }
.agent-form-section-title > span { width: 24px; height: 24px; border-radius: 5px; background: #0f172a; color: #e3ff4d; display: grid; place-items: center; font: 700 8px "JetBrains Mono",monospace; }
.agent-form-section-title h3 { margin: 1px 0 2px; font-size: 11px; }
.agent-form-section-title p { margin: 0; color: #64748b; font-size: 8px; }
.agent-form-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px 12px; }
.vehicle-form-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
.agent-form-field { min-width: 0; display: flex; flex-direction: column; gap: 5px; color: #475569; font-size: 8px; font-weight: 600; }
.agent-form-field > span b { color: #dc2626; }
.agent-form-field > input,.agent-form-field > select,.phone-field { width: 100%; height: 36px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 5px; background: #fff; color: #0f172a; font-size: 10px; outline: 0; }
.agent-form-field > input,.agent-form-field > select { padding: 0 10px; }
.agent-form-field > input::placeholder,.phone-field input::placeholder { color: #94a3b8; }
.agent-form-field > input:focus,.agent-form-field > select:focus,.phone-field:focus-within { border-color: #0f172a; box-shadow: 0 0 0 1px #0f172a; }
.agent-form-field .agent-id-input { background: #f8fafc; color: #475569; font: 600 10px "JetBrains Mono",monospace; }
.phone-field { display: flex; align-items: center; overflow: hidden; }
.phone-field i { height: 100%; padding: 0 9px; border-inline-end: 1px solid #cbd5e1; background: #f8fafc; color: #475569; display: flex; align-items: center; font-size: 9px; font-style: normal; }
.phone-field input { min-width: 0; height: 100%; flex: 1; padding: 0 9px; border: 0; outline: 0; background: transparent; color: #0f172a; font-size: 10px; }
.agent-document-status-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 12px; align-items: start; }
.agent-document-dropzone { min-height: 91px; padding: 12px; border: 2px dashed #e2e8f0; border-radius: 7px; background: #f8fafc; display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 10px; cursor: pointer; }
.agent-document-dropzone:hover,.agent-document-dropzone.dragging { border-color: #64748b; background: #f1f5f9; }
.agent-document-dropzone.invalid { border-color: #fca5a5; background: #fef2f2; }
.agent-document-dropzone > input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.agent-document-dropzone > span:nth-of-type(2) { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.agent-document-dropzone b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 9px; }
.agent-document-dropzone small { color: #64748b; font-size: 7px; line-height: 1.35; }
.agent-document-dropzone em { padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 4px; background: #fff; color: #334155; font-size: 8px; font-style: normal; font-weight: 700; }
.agent-document-error { grid-column: 1; margin-top: -8px; color: #b91c1c; font-size: 8px; }
.agent-status-options { min-width: 0; margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 6px; }
.agent-status-options legend { margin-bottom: 5px; color: #475569; font-size: 8px; font-weight: 700; }
.agent-status-options label { min-height: 42px; padding: 7px 9px; border: 1px solid #e2e8f0; border-radius: 5px; display: grid; grid-template-columns: 0 8px 1fr; align-items: center; gap: 7px; cursor: pointer; }
.agent-status-options label:hover { background: #f8fafc; }
.agent-status-options label.selected { border-color: #94a3b8; background: #f8fafc; box-shadow: inset 2px 0 #0f172a; }
.agent-status-options input { opacity: 0; width: 0; height: 0; margin: 0; }
.agent-status-options label > i { width: 7px; height: 7px; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 0 3px #fef3c7; }
.agent-status-options label > i.available-status { background: #10b981; box-shadow: 0 0 0 3px #d1fae5; }
.agent-status-options label > span { display: flex; flex-direction: column; gap: 2px; }
.agent-status-options b { font-size: 9px; }.agent-status-options small { color: #64748b; font-size: 7px; }
.add-agent-footer { flex: 0 0 auto; padding: 13px 20px; border-top: 1px solid #f1f5f9; background: #fff; display: flex; justify-content: flex-end; gap: 8px; }
.save-agent-button { min-width: 155px; justify-content: center; }
.save-agent-button:disabled { opacity: .7; cursor: wait; }
.button-spinner { width: 11px; height: 11px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: button-spin .7s linear infinite; }
@keyframes button-spin { to { transform: rotate(360deg); } }
.success-toast { position: fixed; z-index: 220; top: 18px; inset-inline-end: 20px; width: 300px; padding: 11px; border: 1px solid #a7f3d0; border-radius: 7px; background: #fff; color: #0f172a; box-shadow: 0 14px 38px rgba(15,23,42,.18); display: grid; grid-template-columns: 28px 1fr 24px; align-items: center; gap: 9px; animation: toast-in .2s ease-out; }
.success-toast > span { width: 28px; height: 28px; border-radius: 50%; background: #ecfdf5; color: #047857; display: grid; place-items: center; }
.success-toast > div { display: flex; flex-direction: column; gap: 2px; }
.success-toast b { font-size: 10px; }.success-toast small { color: #64748b; font-size: 8px; }
.success-toast > button { width: 24px; height: 24px; border: 0; background: transparent; color: #64748b; display: grid; place-items: center; cursor: pointer; }
@keyframes toast-in { from { transform: translateY(-8px); opacity: 0; } }

@media (max-width: 800px) {
  .agent-form-grid,.vehicle-form-grid,.agent-document-status-grid { grid-template-columns: 1fr; }
  .add-agent-modal { width: min(620px,calc(100vw - 24px)); max-height: calc(100vh - 24px); }
}

/* ===== Jobs workspace (Orders reference layout) ===== */
.enterprise-mode .page-body.jw-page { padding: 20px 28px 28px; gap: 0; background: var(--canvas); }
.jw-shell { flex: 1; display: flex; flex-direction: column; gap: 0; min-height: 0; }
.jw {
  flex: 1; min-height: 560px; display: grid; grid-template-columns: clamp(360px, 33%, 470px) minmax(0, 1fr); gap: 14px;
  color: var(--text); font-family: "Outfit", sans-serif;
}
.jw h2, .jw h3 { margin: 0; font-weight: 500; letter-spacing: -.02em; }
.jw button { cursor: pointer; }
.jw button:disabled { cursor: not-allowed; }
.jw-card { background: var(--surface); border-radius: 20px; padding: 22px; min-width: 0; min-height: 0; box-shadow: 0 10px 30px rgba(15,15,17,.06); }
.jw-left { display: flex; flex-direction: column; gap: 14px; min-height: 0; min-width: 0; }

/* list card */
.jw-list { flex: 1; display: flex; flex-direction: column; padding: 22px 0 0; overflow: hidden; }
.jw-list-head { display: flex; align-items: center; justify-content: space-between; padding: 0 22px 16px; }
.jw-list-head h2 { display: flex; align-items: center; gap: 10px; font-size: 21px; }
.jw-count { min-width: 28px; height: 28px; padding: 0 8px; border-radius: 999px; display: inline-grid; place-items: center; background: rgba(227,255,77,.14); color: var(--accent); font-size: 13px; font-weight: 500; letter-spacing: 0; }
.jw-round { width: 42px; height: 42px; border: 0; border-radius: 50%; background: var(--surface-2); color: var(--text); display: grid; place-items: center; flex: 0 0 auto; }
.jw-round:hover { background: var(--surface-3); }
.jw-round.jw-accent { background: var(--accent); color: #151516; }
.jw-round.jw-accent:hover { background: #eeff85; }
.jw-search-row { display: flex; gap: 8px; padding: 0 22px 12px; }
.jw-search { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border-radius: 999px; background: var(--surface-2); color: var(--faint); display: flex; align-items: center; gap: 9px; box-shadow: inset 0 0 0 1px var(--line); }
.jw-search:focus-within { box-shadow: inset 0 0 0 1px var(--accent); }
.jw-search input { min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; color: var(--text); font-size: 13px; }
.jw-search input::placeholder { color: var(--faint); }
.jw .date-range-control { height: 44px; min-width: 0; padding: 0 8px 0 14px; border: 0; border-radius: 999px; background: var(--surface-2); color: var(--muted); box-shadow: inset 0 0 0 1px var(--line); }
.jw .date-range-control select { color: var(--text); font-size: 12px; font-weight: 500; }
.jw .date-range-control select option { color: #0f172a; }
.jw .custom-date-range { inset-inline-start: auto; inset-inline-end: 0; }
.jw-filters { display: flex; gap: 6px; padding: 0 22px 14px; overflow-x: auto; scrollbar-width: none; }
.jw-filters::-webkit-scrollbar { display: none; }
.jw-filters button { flex: 0 0 auto; height: 30px; padding: 0 13px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 12px; }
.jw-filters button:hover { color: var(--text); background: var(--surface-2); }
.jw-filters button.selected { background: var(--text); color: var(--chrome); font-weight: 600; }
.jw-table-head, .jw-row { display: grid; grid-template-columns: 96px minmax(0, 1fr) 52px 78px; align-items: center; column-gap: 10px; padding: 0 22px; }
.jw-table-head { min-height: 38px; border-bottom: 1px solid var(--line); color: var(--faint); font-size: 11px; }
.jw-table-head span:nth-child(3), .jw-row .jw-when { text-align: start; }
.jw-table-head span:last-child, .jw-row .jw-tier { text-align: end; }
.jw-rows { flex: 1; min-height: 0; overflow: auto; }
.jw-row { position: relative; width: 100%; min-height: 54px; border: 0; background: transparent; color: var(--text); text-align: start; font-size: 12.5px; }
.jw-row:hover { background: rgba(227,255,77,.025); }
.jw-row.selected { background: var(--surface-2); }
.jw-row.selected:before { content: ""; position: absolute; inset-block: 0; inset-inline-start: 0; width: 3px; background: var(--accent); }
.jw-id { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; white-space: nowrap; }
.jw-row.selected .jw-id { color: var(--accent); }
.jw-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto; background: #b3a06b; }
.jw-dot.in-transit { background: #8fa8bd; }
.jw-dot.completed { background: #8aa896; }
.jw-dot.returned { background: #c08a86; }
.jw-dot.cancelled { background: #6d6e75; }
.jw-route { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; }
.jw-when { color: var(--muted); font-size: 12px; white-space: nowrap; }
.jw-tier { font-size: 13.5px; font-weight: 500; white-space: nowrap; }
.jw-empty { padding: 34px 22px; text-align: center; color: var(--faint); font-size: 13px; }

/* detail card */
.jw-detail { display: flex; flex-direction: column; gap: 18px; padding: 26px; overflow: auto; }
.jw-detail-empty { align-items: center; justify-content: center; color: var(--faint); }
.jw-detail-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.jw-label { color: var(--muted); font-size: 14px; }
.jw-idline { margin-top: 4px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.jw-idline h2 { font-size: 31px; line-height: 1.1; }
.jw-copy { width: 30px; height: 30px; border: 0; border-radius: 8px; background: transparent; color: var(--muted); display: grid; place-items: center; }
.jw-copy:hover { color: var(--text); background: var(--surface-2); }
.jw-head-actions { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
.jw-ghost, .jw-primary { height: 46px; padding: 0 24px; border-radius: 999px; font-size: 14px; white-space: nowrap; }
.jw-ghost { border: 1px solid var(--line); background: transparent; color: var(--text); }
.jw-ghost:hover { background: var(--surface-2); }
.jw-primary { border: 0; background: var(--accent); color: #151516; font-weight: 600; }
.jw-primary:hover:not(:disabled) { background: #eeff85; }
.jw-primary:disabled { background: var(--surface-3); color: var(--faint); }
.jw-primary.small { height: 38px; padding: 0 16px; font-size: 13px; }
.jw-menu-wrap { position: relative; }
.jw-menu { position: absolute; z-index: 30; top: calc(100% + 8px); inset-inline-end: 0; width: 262px; padding: 6px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); box-shadow: 0 18px 44px rgba(0,0,0,.5); display: flex; flex-direction: column; }
.jw-menu button { min-height: 40px; padding: 8px 12px; border: 0; border-radius: 12px; background: transparent; color: var(--text); display: flex; align-items: center; gap: 11px; text-align: start; font-size: 13px; }
.jw-menu button:hover { background: var(--surface-2); }
.jw-menu button span { display: flex; flex-direction: column; gap: 2px; }
.jw-menu small { color: var(--faint); font-size: 10.5px; }
.jw-menu .danger { color: #d29a96; }

/* status pills */
.jw .status { padding: 6px 11px; border: 0; border-radius: 999px; background: #2a302d; color: #99b1a2; font-size: 12px; font-weight: 500; }
.jw .status.warning { background: #353129; color: #c9b27e; }
.jw .status.info { background: #293039; color: #93b0c4; }
.jw .status.danger { background: #39292b; color: #d29a96; }
.jw .status.neutral { background: #2d2d31; color: #9d9da4; }

/* courier row */
.jw-agent { position: relative; padding: 10px 12px; border: 1px solid var(--line); border-radius: 22px; display: flex; align-items: center; gap: 13px; }
.jw-agent .avatar { width: 46px; height: 46px; font-size: 13px; }
.jw-avatar-empty { width: 46px; height: 46px; border: 1px dashed var(--line); border-radius: 50%; color: var(--muted); display: grid; place-items: center; flex: 0 0 auto; }
.jw-agent-name { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.jw-agent-name b { font-size: 16px; font-weight: 500; }
.jw-agent-name small { color: var(--muted); font-size: 13px; }
.jw-contact { display: flex; gap: 8px; }
.jw-circle { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; color: inherit; text-decoration: none; }
.jw-circle.chat { background: var(--accent); color: #151516; }
.jw-circle.call { background: #2bb673; color: #fff; }
.jw-circle:hover { filter: brightness(1.08); }
.jw-picker { position: absolute; z-index: 20; top: calc(100% + 8px); inset-inline-end: 0; width: min(360px, 100%); padding: 8px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); box-shadow: 0 18px 44px rgba(0,0,0,.5); }
.jw-picker-title { padding: 8px 10px 10px; display: flex; flex-direction: column; gap: 2px; }
.jw-picker-title b { font-size: 14px; font-weight: 500; }
.jw-picker-title small { color: var(--muted); font-size: 11.5px; }
.jw-picker button { width: 100%; min-height: 52px; padding: 6px 10px; border: 0; border-radius: 14px; background: transparent; color: var(--text); display: flex; align-items: center; gap: 11px; text-align: start; }
.jw-picker button:hover, .jw-picker button.selected { background: var(--surface-2); }
.jw-picker button.selected { box-shadow: inset 3px 0 var(--accent); }
.jw-picker .avatar { width: 34px; height: 34px; font-size: 10px; }
.jw-picker button > span { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.jw-picker button b { font-size: 13.5px; font-weight: 500; }
.jw-picker button small { color: var(--muted); font-size: 11.5px; }
.jw-picker em { color: var(--muted); font-size: 11.5px; font-style: normal; }

/* route header + corridor */
.jw-route-head { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
.jw-route-head > div { display: flex; align-items: center; gap: 10px; }
.jw-route-head h3 { font-size: 21px; }
.jw-tag { padding: 5px 11px; border-radius: 999px; background: var(--surface-2); color: var(--accent); font-size: 12.5px; }
.jw-link { padding: 0; border: 0; background: transparent; color: var(--accent); display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
.jw-link:hover:not(:disabled) { text-decoration: underline; text-underline-offset: 3px; }
.jw-link:disabled { opacity: .6; }
.jw-corridor { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.jw-corridor > div { min-width: 0; padding: 20px 22px; border-radius: 22px; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--line); }
.jw-corridor > div.end { text-align: end; }
.jw-corridor small { display: block; color: var(--muted); font-size: 13.5px; }
.jw-corridor b { display: block; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: clamp(22px, 2.2vw, 31px); font-weight: 500; letter-spacing: -.02em; }
.jw-duration { position: absolute; z-index: 1; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 6px 13px; border-radius: 999px; background: var(--accent); color: #151516; font-size: 13px; font-weight: 500; white-space: nowrap; }

/* map + custody timeline */
.jw-route-body { flex: 1; min-height: 300px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
.jw-map { position: relative; min-height: 300px; border-radius: 22px; overflow: hidden; background: #ecedef; display: flex; }
.jw-map svg { width: 100%; height: 100%; }
.jw-map-expand { position: absolute; top: 12px; inset-inline-end: 12px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(200,201,205,.92); color: #2b2d31; display: grid; place-items: center; }
.jw-map-expand:hover { background: #fff; }
.jw-timeline { position: relative; margin: 0; padding: 4px 0; list-style: none; display: flex; flex-direction: column; gap: 16px; }
.jw-timeline:before { content: ""; position: absolute; inset-block: 12px; inset-inline-start: 5px; border-inline-start: 2px dashed rgba(227,255,77,.45); }
.jw-stop { position: relative; padding-inline-start: 28px; }
.jw-stop-dot { position: absolute; top: 5px; inset-inline-start: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--surface-3); box-shadow: 0 0 0 4px var(--surface); }
.jw-stop.reached .jw-stop-dot, .jw-stop.current .jw-stop-dot { background: var(--accent); }
.jw-stop-time { color: var(--muted); font-size: 14px; }
.jw-stop-time span { margin-inline-start: 8px; }
.jw-stop-place { margin-top: 3px; display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
.jw-stop-place b { font-size: 15.5px; font-weight: 500; }
.jw-stop-place span { color: var(--faint); font-size: 14px; }
.jw-stop:not(.reached):not(.current) .jw-stop-place b { color: var(--muted); }
.jw-stop-card { padding: 13px 15px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface-2); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; }
.jw-radio { width: 18px; height: 18px; border: 2px solid var(--accent); border-radius: 50%; display: grid; place-items: center; }
.jw-radio:after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
.jw-callout { grid-column: 1 / -1; width: max-content; max-width: 100%; padding: 4px 11px; border-radius: 999px; background: var(--accent); color: #171719; font-size: 12.5px; font-style: normal; font-weight: 600; }

@media (max-width: 1380px) {
  .jw-route-body { grid-template-columns: 1fr; }
  .jw-map { min-height: 260px; }
}
